# Root env template for local development.
#
# WHETHER A `.env` IS READ DEPENDS ON WHICH WAY YOU RUN THE SERVER, and the
# two answers are opposite:
#
#   Running on the HOST (`bb dev`)     — a `.env` is IGNORED. `mise.toml` has
#                                        no `_.file` directive and no other
#                                        loader picks one up, so a filled-in
#                                        copy is silently ignored (#302). Set
#                                        these in `mise.local.toml`
#                                        (gitignored) or your shell profile.
#   Running in the NEWCOMER CONTAINER  — a `.env` IS read, by docker compose:
#   (docker-compose.newcomer.yml)        the `digdir-rag` service declares
#                                        `env_file: .env`, and the documented
#                                        first step is `cp .env.example .env`.
#
# So: copy this file only for the container path. On the host it is a
# reference list. Every value below is a PLACEHOLDER — replace before use,
# never commit real secrets. See docs/onboarding.md for the full boot
# walkthrough and docs/system-overview.md §7.2 for the authoritative
# variable reference.
#
# Vars are grouped by when they're needed:
#   BOOT MINIMUM  — the server refuses to start without these.
#   QUERY-TIME    — the server boots, but a real /api/mcp query needs these.
#   OPTIONAL      — dev convenience; sensible defaults if unset.

# =============================================================================
# BOOT MINIMUM — one DB pointer + two secrets (digdir.config.core/load-bootstrap-config)
# =============================================================================

# --- Database: pick ONE of the two options below -----------------------------

# Option A (easy, Postgres-free, preferred for local dev/test): a local
# Datahike file-backed DB. The DB directory itself is created on first boot,
# but its PARENT must already exist — `server/local-db/` is gitignored, so on
# a fresh clone you must `mkdir -p server/local-db` first or the boot
# pre-flight refuses with "parent directory does not exist". Paths are
# resolved relative to `server/`.
DATAHIKE_FILE_PATH=./local-db/changeme-dev-v1

# Option B (remote/shared Postgres-backed Datahike). Leave DATAHIKE_FILE_PATH
# unset if you use this instead — DATAHIKE_FILE_PATH takes precedence when both are set.
# ADH_POSTGRES_URL=jdbc:postgresql://your-postgres-host:5432/changeme-dbname
# ADH_POSTGRES_USER=changeme-postgres-user
# ADH_POSTGRES_PWD=changeme-postgres-password

# --- Required regardless of which DB option you picked -----------------------

# Encrypts secrets stored in the config DB (API keys, provider keys, etc).
# Any non-empty string works for local dev; treat it as a real secret once
# you have data you care about, since losing it makes stored secrets unrecoverable.
CONFIG_MASTER_KEY=changeme-config-master-key

# Signs auth JWTs. No gen-jwt-secret.sh script ships in this repo — generate
# one yourself:
#   openssl rand -base64 32
JWT_SECRET=changeme-jwt-secret-generate-with-openssl-rand

# =============================================================================
# QUERY-TIME — needed to reach a working /api/mcp result, not to boot
# =============================================================================

# Typesense holds the document/chunk/phrase collections retrieval searches.
# The running server reads Typesense connection details from the config DB —
# and `bb migration-import` writes TYPESENSE_API_KEY_ADMIN there for you, so
# setting it before the import is enough (`digdir.config.env-bridge`).
TYPESENSE_API_KEY_ADMIN=changeme-typesense-admin-key
# TYPESENSE_API_KEY is read by nothing in this repository — no runtime call
# site and, since the setup table became derived, no presence check either.
TYPESENSE_API_KEY=changeme-typesense-search-key

# ⚠️ REQUIRED for the shipped tenants, and NOT in the config snapshot. Both name
# where our infrastructure lives rather than a credential, so neither is
# committed; the import leaves these paths empty and a clean install supplies
# them. Blank on purpose rather than a sample host.
#
# TYPESENSE_API_HOST is a HOST:PORT, not a URL - it carries no scheme, which is
# why `api-tls` exists separately.
TYPESENSE_API_HOST=
# The ColBERT reranking service. OPTIONAL: since #519 an unconfigured reranker
# DEGRADES rather than throwing — retrieval still answers, ordering is just less
# good, and a one-time warning names it. (This block used to say "absent,
# reranking fails with a message naming this variable"; that was true until
# #519, when the throw took down the whole skill graph for a newcomer who had
# quite reasonably not configured infrastructure we ship no value for.)
COLBERT_API_URL=

# --- Demo tenant: OPTIONAL overrides, all with working defaults ---------------
#
# `bb demo-seed` authors the demo tenant's own Typesense settings so it never
# borrows another tenant's (#476). The defaults below are what it writes, and
# they already work against `docker-compose.newcomer.yml` — you do NOT need to
# set these. Set one only to point the demo tenant somewhere else; the config
# env-bridge then writes your value over the seeded default.
#
# The admin key is deliberately NOT among them: it is the one secret here, it is
# never authored into the template, and it arrives from TYPESENSE_API_KEY_ADMIN
# above at run time.
#
# (TYPESENSE_API_HOST is declared above - for the demo tenant, typesense:8108)
# TYPESENSE_API_TLS=false
# TYPESENSE_COLLECTION_PREFIX=demo_

# --- LLM provider: pick ONE of the two paths below ---------------------------
#
# Which path runs is decided in the CONFIG DB, not here, by
# `services.azure-openai.use-azure-openai-api`. Both paths read the same
# `services.azure-openai.*` family — the name is historical, not a scope. See
# docs/onboarding.md §4a.

# Path A - Azure OpenAI (use-azure-openai-api true — SET IT; there is no shipped
# default any more and unset means NOT Azure, see AZURE_OPENAI_USE_AZURE below). The
# deployment is read from the config DB; these two variables are the auto-seed
# inputs that write the key and the endpoint there
# (digdir.e2e.seed/seed-azure-config-from-env!, needs TENANT set too).
AZURE_OPENAI_API_KEY=changeme-azure-openai-key
# ⚠️ REQUIRED, and NOT shipped in the config snapshot. The endpoint names the
# Azure resource it points at, which is our infrastructure rather than a
# secret — so it is not committed, and the import leaves this path empty. A
# clean install must supply it. Left blank on purpose: a plausible-looking
# placeholder here is worse than nothing, because someone will try it.
AZURE_OPENAI_API_ENDPOINT=
# ⚠️ REQUIRED TOO, and the one most easily missed. The Azure path reads
# api-key, api-endpoint AND deployment-name from config — see the
# `true ->` branch documented on `env-bridge/first-query-bindings`. Its value
# used to arrive with the shipped `digdir` tenant; that tenant is no longer
# shipped, so a clean install must supply it. It is the name YOU gave a
# deployment inside YOUR Azure resource, so there is no default worth shipping.
AZURE_OPENAI_DEPLOYMENT_NAME=
#
# The remaining three azure variables are OPTIONAL, and are listed so their
# absence is a decision rather than a gap:
#
#   AZURE_OPENAI_USE_AZURE   the path switch. ⚠️ ABSENT MEANS *NOT* AZURE.
#                            This block used to say the opposite, and it was
#                            true of the VERIFIER only: the verifier read it
#                            with :default true while the RUNTIME read it with
#                            no default at all, so verification reported :azure
#                            while queries went to generic OpenAI and failed
#                            with `Missing secret :openai-api-key` (#500).
#                            There is now ONE read, `accessor/use-azure-openai?`,
#                            and it takes the runtime's meaning. So SET IT TRUE
#                            for path A; leave it unset or false for path B.
#   AZURE_OPENAI_MODEL_NAME  used by path B, not path A.
#   AZURE_OPENAI_API_VERSION not read by the main LLM call path — the Azure
#                            client sends its own — only by
#                            `rag/auto-filter-rules`. Set it if you use that.
#
# AZURE_OPENAI_USE_AZURE=
# AZURE_OPENAI_MODEL_NAME=
# AZURE_OPENAI_API_VERSION=

# Path B - any OpenAI-compatible server, INCLUDING A LOCAL ONE (LM Studio,
# Ollama, vLLM, llama.cpp) with `use-azure-openai-api` false. Needs no cloud
# account. Unlike path A these two are read from the ENVIRONMENT at call time
# (digdir.llm.client/openai-compat-completion), so they cannot be set with
# `bb config-set`.
#
# Of those four, ONLY LM STUDIO HAS BEEN RUN THROUGH THIS PATH. They reach the
# same client code - one OpenAI-compatible POST regardless of what answers it -
# so there is no reason to expect them to differ, but the other three are
# untested here. See docs/onboarding.md §4a step 0.
#
# OPENAI_API_ENDPOINT is the base URL, INCLUDING /v1 and excluding
# /chat/completions. LM Studio: http://localhost:1234/v1 (verified). Ollama:
# http://localhost:11434/v1 (its documented default; not run here). Leave it
# unset and the client falls back to https://api.openai.com/v1 - observed: a
# local run then fails as a 401 from the PUBLIC OpenAI API rather than as a
# missing setting, and bb dev's log names Domain=api.openai.com.
# OPENAI_API_ENDPOINT=http://localhost:1234/v1
#
# OPENAI_API_KEY must be NON-EMPTY even when the local server ignores it:
# digdir.secrets/get! throws on an absent secret rather than sending a keyless
# request (#22). Any placeholder works.
# OPENAI_API_KEY=local

# Read only by digdir.llm.anthropic, which no other namespace currently
# requires. Neither path above needs it.
# ANTHROPIC_API_KEY=changeme-anthropic-key

# =============================================================================
# OPTIONAL — dev convenience, sensible defaults if unset
# =============================================================================

# Who may log in and administer this instance. Comma/space-separated.
#
# ⚠️ UNCOMMENT THIS LINE and put your own address in it. This one is NOT
#    "sensible defaults if unset" like the rest of this section: unset, no
#    admin is created and every address is refused at /not-approved.
#
#    Editing the address but leaving the leading `#` is indistinguishable,
#    at every later step, from never having set it — setup reports
#    "0 created, 0 granted" and login refuses, with nothing connecting the
#    two. `./scripts/setup-env.sh` asks for this and writes it uncommented,
#    which is the path that does not depend on noticing a `#`.
#
#    It ships COMMENTED on purpose: an uncommented address here would be a
#    real, working admin on every deployment that copied this file unedited,
#    and the placeholder boot check does not cover this variable — it covers
#    secrets, and this is not one.
# ADMIN_USER_EMAILS=changeme@example.com

# Overrides `bb dev`'s default port (8081) — useful when running multiple
# worktrees' dev servers side by side.
# HTTP_PORT=8081

# Set to a working API-key plaintext to auto-seed it into the config DB on
# boot, along with the built-in agents (skips minting a key through the admin
# UI / console API). See docs/onboarding.md's "first queryable dataset" recipe.
# Format is `rag_` followed by 64 hex characters.
#
# LEAVING IT COMMENTED OUT IS FINE FOR THE NEWCOMER CONTAINER: that stack
# supplies its own committed local-only default and hands the same value to
# Open WebUI, so the chat UI's model dropdown fills either way. Set it here
# only to pin your own value — and if you do, the container path picks it up
# for BOTH services, which is the point (they have to agree).
# E2E_API_KEY=changeme-local-api-key

# =============================================================================
# OPTIONAL SERVICES — no correct global default, so nothing is shipped for them
# =============================================================================
#
# Each of these is `:deployment-specific?` (digdir.config.deployment-specific)
# AND has an env-bridge binding, which together mean: the product cannot ship a
# value, so if you use the service you must supply it here. Listed even where
# the service is optional, so that an absent value is a choice rather than a
# thing nobody mentioned. `env-example-coverage-test` fails if a new such path
# is added without appearing here.

# ColBERT reranking (see COLBERT_API_URL above).
COLBERT_API_KEY=

# LM Studio, when reached as a configured service rather than through
# OPENAI_API_ENDPOINT above.
LMSTUDIO_API_ENDPOINT=
LMSTUDIO_API_KEY=

# Marker, the document parser used by the ingest pipeline for PDFs.
MARKER_API_URL=
MARKER_API_KEY=

# OpenRouter, an alternative LLM provider.
OPENROUTER_API_KEY=

# Scaleway Transactional Email — sends admin login codes. Without it the admin
# UI cannot email a login code; see `bb setup`.
SCALEWAY_TEM_API_KEY=

# =============================================================================
# OPTIONAL — tracing to Langfuse
# =============================================================================
#
# DELIBERATELY NOT UNDER "OPTIONAL SERVICES" ABOVE. Everything there is
# `:deployment-specific?` with an env-bridge binding, i.e. it lands in the
# config DB and is resolved per tenant. These five are read STRAIGHT FROM THE
# ENVIRONMENT by `digdir.telemetry.langfuse`, because tracing is a property of
# the DEPLOYMENT rather than of a tenant — and a run that fails before tenant
# resolution still deserves a trace. `env-example-coverage-test` does not
# police them for the same reason: there is no config path to cover.
#
# WHAT YOU GET. One trace per RAG run, emitted from
# `digdir.skills.invoke/invoke-rag` — the canonical entry that
# /v1/chat/completions, the Playground and MCP `tools/call` all converge on, so
# one setting traces all three surfaces:
#
#     root span            the question, the answer, status, chunk count
#       └── generation     one per LLM call that reported tokens, named by
#                          agent stage (:agent-llm, :read-signal-eval,
#                          :generate_response) with per-call token counts
#
# ⚠️ THIS SENDS THE QUESTION AND THE ANSWER OFF THE BOX. That is what tracing
# is, and it is why LANGFUSE_ENABLED is off unless you set it. Know where your
# instance lives before turning it on.
#
# The whole integration is a no-op unless LANGFUSE_ENABLED is "true" AND the
# three values below it are present. Enabled-without-keys is a
# misconfiguration that would otherwise fail once per query, forever, in the
# log — so an unconfigured instance is simply off.

# "true" enables tracing. Anything else, including empty, is off.
LANGFUSE_ENABLED=

# The key pair identifies the project — there is no project id to supply
# anywhere. Langfuse → the project → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=changeme-pk-lf-key
LANGFUSE_SECRET_KEY=changeme-sk-lf-key

# The ROOT of the instance, WITHOUT any /api/... path — the OTLP path is
# appended for you, and a trailing slash is stripped. Cloud is
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US);
# self-hosted is your own URL. Needs Langfuse v3.22.0+ for the OTLP endpoint.
LANGFUSE_BASE_URL=

# Free text. Surfaces as the trace's `environment` field and is what you filter
# on to tell a laptop apart from test and prod. Unset means no environment is
# recorded.
LANGFUSE_ENVIRONMENT=

# "true" also traces the chat client's own housekeeping calls. Off by default.
#
# Open WebUI calls /v1/chat/completions a SECOND time after every message — for
# follow-up suggestions, and again for conversation titles, tags and search
# queries, all four on by default in its own config. Those run the full agent:
# measured here, one follow-up generation cost 1265 tokens against 4189 for the
# question that triggered it. It is the chat client's feature, not this
# product's, so by default it is not this product's trace either.
#
# They ARE real spend, so turn this on when that is what you are measuring.
# LANGFUSE_TRACE_CLIENT_TASKS=true
