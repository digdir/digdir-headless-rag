# Root env template for local development.
#
# THIS IS A REFERENCE LIST, NOT A FILE TO COPY INTO PLACE. Nothing in this
# repo loads a `.env` — `mise.toml` has no `_.file` directive and no other
# loader picks one up — so a filled-in copy is silently ignored (#302). Set
# the variables below in `mise.local.toml` (gitignored) or in your shell
# profile. Every value below is a PLACEHOLDER — replace before use, never
# commit real secrets. See docs/onboarding.md for the full boot walkthrough
# and docs/system-overview.md §7.2 for the authoritative variable reference.
#
# Vars are grouped by when they're needed:
#   BOOT MINIMUM  — the server refuses to start without these.
#   QUERY-TIME    — the server boots, but a real /api/mcp query needs these.
#   OPTIONAL      — dev convenience; sensible defaults if unset.

# =============================================================================
# BOOT MINIMUM — one DB pointer + two secrets (digdir.config.core/load-bootstrap-config)
# =============================================================================

# --- Database: pick ONE of the two options below -----------------------------

# Option A (easy, Postgres-free, preferred for local dev/test): a local
# Datahike file-backed DB. The DB directory itself is created on first boot,
# but its PARENT must already exist — `server/local-db/` is gitignored, so on
# a fresh clone you must `mkdir -p server/local-db` first or the boot
# pre-flight refuses with "parent directory does not exist". Paths are
# resolved relative to `server/`.
DATAHIKE_FILE_PATH=./local-db/changeme-dev-v1

# Option B (remote/shared Postgres-backed Datahike). Leave DATAHIKE_FILE_PATH
# unset if you use this instead — DATAHIKE_FILE_PATH takes precedence when both are set.
# ADH_POSTGRES_URL=jdbc:postgresql://your-postgres-host:5432/changeme-dbname
# ADH_POSTGRES_USER=changeme-postgres-user
# ADH_POSTGRES_PWD=changeme-postgres-password

# --- Required regardless of which DB option you picked -----------------------

# Encrypts secrets stored in the config DB (API keys, provider keys, etc).
# Any non-empty string works for local dev; treat it as a real secret once
# you have data you care about, since losing it makes stored secrets unrecoverable.
CONFIG_MASTER_KEY=changeme-config-master-key

# Signs auth JWTs. No gen-jwt-secret.sh script ships in this repo — generate
# one yourself:
#   openssl rand -base64 32
JWT_SECRET=changeme-jwt-secret-generate-with-openssl-rand

# =============================================================================
# QUERY-TIME — needed to reach a working /api/mcp result, not to boot
# =============================================================================

# Typesense holds the document/chunk/phrase collections retrieval searches.
# The running server reads Typesense connection details from the config DB —
# and `bb migration-import` writes TYPESENSE_API_KEY_ADMIN there for you, so
# setting it before the import is enough (`digdir.config.env-bridge`).
TYPESENSE_API_KEY_ADMIN=changeme-typesense-admin-key
# TYPESENSE_API_KEY is read by nothing in this repository — no runtime call
# site and, since the setup table became derived, no presence check either.
TYPESENSE_API_KEY=changeme-typesense-search-key

# --- LLM provider: pick ONE of the two paths below ---------------------------
#
# Which path runs is decided in the CONFIG DB, not here, by
# `services.azure-openai.use-azure-openai-api`. Both paths read the same
# `services.azure-openai.*` family — the name is historical, not a scope. See
# docs/onboarding.md §4a.

# Path A - Azure OpenAI (use-azure-openai-api true, the shipped default). The
# endpoint, deployment and key are read from the config DB; this variable is
# only the auto-seed input that writes the key there
# (digdir.e2e.seed/seed-azure-config-from-env!, needs TENANT set too).
AZURE_OPENAI_API_KEY=changeme-azure-openai-key

# Path B - any OpenAI-compatible server, INCLUDING A LOCAL ONE (LM Studio,
# Ollama, vLLM, llama.cpp) with `use-azure-openai-api` false. Needs no cloud
# account. Unlike path A these two are read from the ENVIRONMENT at call time
# (digdir.llm.client/openai-compat-completion), so they cannot be set with
# `bb config-set`.
#
# Of those four, ONLY LM STUDIO HAS BEEN RUN THROUGH THIS PATH. They reach the
# same client code - one OpenAI-compatible POST regardless of what answers it -
# so there is no reason to expect them to differ, but the other three are
# untested here. See docs/onboarding.md §4a step 0.
#
# OPENAI_API_ENDPOINT is the base URL, INCLUDING /v1 and excluding
# /chat/completions. LM Studio: http://localhost:1234/v1 (verified). Ollama:
# http://localhost:11434/v1 (its documented default; not run here). Leave it
# unset and the client falls back to https://api.openai.com/v1 - observed: a
# local run then fails as a 401 from the PUBLIC OpenAI API rather than as a
# missing setting, and bb dev's log names Domain=api.openai.com.
# OPENAI_API_ENDPOINT=http://localhost:1234/v1
#
# OPENAI_API_KEY must be NON-EMPTY even when the local server ignores it:
# digdir.secrets/get! throws on an absent secret rather than sending a keyless
# request (#22). Any placeholder works.
# OPENAI_API_KEY=local

# Read only by digdir.llm.anthropic, which no other namespace currently
# requires. Neither path above needs it.
# ANTHROPIC_API_KEY=changeme-anthropic-key

# =============================================================================
# OPTIONAL — dev convenience, sensible defaults if unset
# =============================================================================

# Comma/space-separated emails granted admin-full permission on setup/sync.
# ADMIN_USER_EMAILS=changeme@example.com

# Overrides `bb dev`'s default port (8081) — useful when running multiple
# worktrees' dev servers side by side.
# HTTP_PORT=8081

# Set to a working API-key plaintext to auto-seed it into the config DB on
# boot (skips minting one through the admin UI / console API). See
# docs/onboarding.md's "first queryable dataset" recipe.
# E2E_API_KEY=changeme-local-api-key
