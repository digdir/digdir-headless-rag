                               (let [kamal-dest (kamal-destination dest)]
                                 (if (= kamal-dest "prod")
                                   (shell "kamal" "app" "boot" "--config-file=deploy.yml")
                                   (shell "kamal" "app" "boot" "--config-file=deploy.yml" (str "--destination=" kamal-dest))))
                               (show-destination-error "boot-server")))}

