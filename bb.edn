         diagnose-db-config {:doc "Diagnose local Datahike config vs stored-config mismatch (usage: bb diagnose-db-config)"
                             :task (clojure {:dir "server"}
                                            "-M"
                                            "-e"
                                            "(do
                                               (require '[digdir.config.core :as cfg] '[datahike.api :as d] '[clojure.pprint :as pp] '[taoensso.timbre :as timbre])
                                               (timbre/set-min-level! :fatal)
                                             (let [bootstrap (cfg/load-bootstrap-config)
                                                   env (:db-env bootstrap)
                                                   db-cfg (get bootstrap env)
                                                   path (System/getenv \"DATAHIKE_FILE_PATH\")]
                                               (println)
                                               (println \"Datahike DB Config Diagnostic\")
                                               (println \"=============================\")
                                               (println \"DATAHIKE_FILE_PATH:\" (pr-str path))
                                               (println \"resolved db-env:  \" env)
                                               (println)
                                               (cond
                                                 (nil? db-cfg)
                                                 (println \"No DB config resolved. Set DATAHIKE_FILE_PATH or ADH_POSTGRES_URL.\")

                                                 (and path (not (.exists (java.io.File. path))))
                                                 (println (str \"DB path does not exist yet: \" path \" (will be created on first connect).\"))

                                                 :else
                                                 (do
                                                   (println \"Attempting connect...\")
                                                   (try
                                                     (let [conn (d/connect db-cfg)]
                                                       (println \"Connected OK. Stored config matches current config.\")
                                                       (d/release conn))
                                                     (catch clojure.lang.ExceptionInfo e
                                                       (let [{:keys [type config stored-config diff]} (ex-data e)]
                                                         (if (= type :config-does-not-match-stored-db)
                                                           (do
                                                             (println)
                                                             (println \"MISMATCH: config-does-not-match-stored-db\")
                                                             (println)
                                                             (println \"current :store identity:\")
                                                             (pp/pprint (:store config))
                                                             (println \"stored  :store identity:\")
                                                             (pp/pprint (:store stored-config))
                                                             (println)
                                                             (println \"diff (current-only, stored-only, common):\")
                                                             (pp/pprint diff)
                                                             (println)
                                                             (println \"Remediation:\")
                                                             (println \"  The :file backend identity includes the host (hostname/IP).\")
                                                             (println \"  A mismatch usually means the machine's IP/hostname changed since the DB was\")
                                                             (println \"  created, or the local-db was copied from another host.\")
                                                             (println)
                                                             (println \"  Options:\")
                                                             (println (str \"    1. Delete and reseed from a snapshot:  rm -rf \" path \" && bb migration-import <snapshot.json>\"))
                                                             (println (str \"    2. Start fresh empty DB:                rm -rf \" path))
                                                             (println \"    3. Add :allow-unsafe-config true to the bootstrap store config\")
                                                             (println \"       in digdir.config.core/load-bootstrap-config (advanced, skips this check).\")
                                                             (System/exit 1))
                                                           (throw e)))))))))")}

