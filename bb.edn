{:tasks
 {:init (do
          ;; Deploy host. Single override point, shared with deploy.yml, which
          ;; reads the same DIGDIR_DEPLOY_HOST variable for `servers:` and
          ;; `builder.remote`. Unset falls back to the current production host,
          ;; so existing deploys and port-forwards behave exactly as before.
          ;; Standing up a second environment means exporting the variable, not
          ;; editing tracked files.
          (def deploy-host
            (or (not-empty (System/getenv "DIGDIR_DEPLOY_HOST")) "5.75.220.232"))

          (def valid-destinations
            ["test" "prod"])

          (def destination-mapping
            {"prod" "prod"
             "test" "test"})

          (defn kamal-destination [user-dest]
            "Maps user-friendly destination name to actual kamal destination name"
            (get destination-mapping user-dest user-dest))

          (defn show-destination-error [task-name]
            (println "Error: destination is required.")
            (println (str "\nUsage: bb " task-name " <destination>"))
            (println "\nValid destinations:")
            (doseq [dest valid-destinations]
              (println (str "  - " dest))))

          ;; API base URLs for integration testing
          (def api-base-urls
            {"prod" "https://admin.kunnskap.digdir.cloud"
             "test" "https://admin.test.kunnskap.digdir.cloud"})

          (defn show-integration-test-error []
            (println "Error: config-key is required.")
            (println "\nUsage: bb integration-test <config-key>")
            (println "\nAvailable config-keys:")
            (doseq [env (keys api-base-urls)]
              (println (str "  - " env))))

          (def read-edn (fn [s]
                          (clojure.edn/read-string {:readers {'sorted/map identity}} s)))
          (def write-json (requiring-resolve 'cheshire.core/generate-string))
          (def status-line-re (re-pattern "\\n__STATUS__:(\\d{3})\\s*$"))
          (def status-strip-re (re-pattern "\\n__STATUS__:\\d{3}\\s*$"))

          (defn debug-api-base-url []
            (or (System/getenv "RAG_API_BASE_URL")
                "http://localhost:8081"))

          (defn debug-api-key []
            (System/getenv "RAG_DEBUG_API_KEY"))

          (defn call-debug-endpoint
            [endpoint params]
            (let [api-key (debug-api-key)
                  _ (when-not api-key
                      (throw (ex-info "Missing debug API key: set RAG_DEBUG_API_KEY" {})))
                  url (str (debug-api-base-url) endpoint)
                  query-args (->> params
                                  (remove (fn [[_ v]]
                                            (or (nil? v)
                                                (and (string? v) (clojure.string/blank? v)))))
                                  (mapcat (fn [[k v]]
                                            ["--data-urlencode" (str (name k) "=" v)])))
                  curl-args (concat ["curl" "-sS" "--get" url
                                     "-H" (str "X-Debug-Api-Key: " api-key)
                                     "-w" "\n__STATUS__:%{http_code}"]
                                    query-args)
                  result (apply shell {:out :string :err :out :continue true} curl-args)
                  out (:out result)
                  status-match (re-find status-line-re out)
                  status (some-> status-match second Integer/parseInt)
                  body (clojure.string/replace out status-strip-re "")]
              (when-not (zero? (:exit result))
                (throw (ex-info "curl failed" {:exit (:exit result) :body body})))
              (when (or (nil? status) (>= status 400))
                (throw (ex-info "Debug endpoint request failed" {:status status :body body})))
              body))

          (defn call-debug-endpoint-edn
            [endpoint params]
            (read-edn (call-debug-endpoint endpoint params)))

          (defn call-debug-endpoint-post
            [endpoint body]
            (let [api-key (debug-api-key)
                  _ (when-not api-key
                      (throw (ex-info "Missing debug API key: set RAG_DEBUG_API_KEY" {})))
                  url (str (debug-api-base-url) endpoint)
                  payload (write-json body)
                  curl-args ["curl" "-sS" "-X" "POST" url
                             "-H" (str "X-Debug-Api-Key: " api-key)
                             "-H" "Content-Type: application/json"
                             "--data-raw" payload
                             "-w" "\n__STATUS__:%{http_code}"]
                  result (apply shell {:out :string :err :out :continue true} curl-args)
                  out (:out result)
                  status-match (re-find status-line-re out)
                  status (some-> status-match second Integer/parseInt)
                  body (clojure.string/replace out status-strip-re "")]
              (when-not (zero? (:exit result))
                (throw (ex-info "curl failed" {:exit (:exit result) :body body})))
              (when (or (nil? status) (>= status 400))
                (throw (ex-info "Debug endpoint request failed" {:status status :body body})))
              body))

          (defn call-debug-endpoint-post-edn
            [endpoint body]
            (read-edn (call-debug-endpoint-post endpoint body)))

          (defn parse-last-edn-line
            [s]
            (let [lines (reverse (clojure.string/split-lines (or s "")))]
              (or
               (some (fn [line]
                       (let [line (clojure.string/trim line)]
                         (when (seq line)
                           (try
                             (read-edn line)
                             (catch Throwable _ nil)))))
                     lines)
               (throw (ex-info "No EDN payload found in command output" {:output s})))))

          (defn edn-line?
            [line]
            (let [line (clojure.string/trim (str (or line "")))]
              (when (seq line)
                (try
                  (read-edn line)
                  true
                  (catch Throwable _ false)))))

          (defn ensure-cli-flag
            [cli-opts flag value]
            (if (some (fn [x] (= flag x)) cli-opts)
              (vec cli-opts)
              (vec (concat cli-opts [flag value]))))

          (defn dataset-ref-params
            [tenant config-key pipeline]
            {:tenant tenant
             :config-key config-key
             :pipeline pipeline})

          (defn parse-cli-flags
            "Parse a vec of `--key value` pairs into a map.
             Bare flags (no value) become `true`.
             Unknown trailing tokens are placed under `:_positional`."
            [tokens]
            (loop [m {} positional [] xs (vec tokens)]
              (cond
                (empty? xs)
                (cond-> m (seq positional) (assoc :_positional positional))

                (clojure.string/starts-with? (str (first xs)) "--")
                (let [k (keyword (subs (str (first xs)) 2))
                      next-tok (second xs)
                      val? (and next-tok
                                (not (clojure.string/starts-with? (str next-tok) "--")))]
                  (if val?
                    (recur (assoc m k next-tok) positional (drop 2 xs))
                    (recur (assoc m k true) positional (drop 1 xs))))

                :else
                (recur m (conj positional (first xs)) (rest xs)))))

          (def diataxis-universe
            "Canonical Diátaxis docs-framework values used by the
             website pipeline's Hugo frontmatter. Hardcoded because
             this is a closed set defined by the framework, not data
             from the corpus."
            ["explanation" "how-to-guides" "reference" "tutorials"])

          (defn diataxis-filter-clause
            "Build a Typesense filter_by clause for matching one or more
             diataxis values, with optional inclusion of docs that have
             NO diataxis value set.

             - When `permissive?` is true, uses `diataxis:!=[<others>]`
               which matches both the requested values AND docs without
               any diataxis field (~32% of the corpus). Recommended.
             - When `permissive?` is false, uses strict
               `diataxis:=[<requested>]`.

             Returns nil if `values` is empty or covers the full universe
             (no filter needed)."
            [values permissive?]
            (let [requested (->> (clojure.string/split (str values) (re-pattern ","))
                                 (map clojure.string/trim)
                                 (remove clojure.string/blank?)
                                 set)]
              (when (and (seq requested)
                         (not= requested (set diataxis-universe)))
                (if permissive?
                  (let [others (->> diataxis-universe
                                    (remove requested)
                                    (clojure.string/join ","))]
                    (str "diataxis:!=[" others "]"))
                  (str "diataxis:=[" (clojure.string/join "," requested) "]")))))

          (defn merge-filter-clauses
            "Combine N filter_by clauses with `&&`, skipping nil/blank ones."
            [& clauses]
            (let [non-empty (->> clauses
                                 (remove nil?)
                                 (remove clojure.string/blank?))]
              (when (seq non-empty)
                (clojure.string/join " && " non-empty))))

          (defn ts-search-params
            "Build query params for /api/debug/typesense-search from positional
             args + parsed --flag map.

             Special handling for --diataxis / --diataxis-strict: builds a
             filter clause that matches the named diataxis value(s).
             By default the filter is *permissive* — it also includes docs
             that have no diataxis value set (a content gap; ~32% of the
             corpus). Pass --diataxis-strict to require an explicit match."
            [tenant config-key role q flags]
            (let [diataxis-clause (when (:diataxis flags)
                                    (diataxis-filter-clause
                                     (:diataxis flags)
                                     (not (:diataxis-strict flags))))
                  combined-filter (merge-filter-clauses
                                   (:filter-by flags)
                                   diataxis-clause)]
              (cond-> {:tenant tenant
                       :dataset-config-key config-key
                       :role role
                       :q q}
                (:query-by flags)       (assoc :query-by (:query-by flags))
                combined-filter         (assoc :filter-by combined-filter)
                (:sort-by flags)        (assoc :sort-by (:sort-by flags))
                (:facet-by flags)       (assoc :facet-by (:facet-by flags))
                (:include-fields flags) (assoc :include-fields (:include-fields flags))
                (:limit flags)          (assoc :limit (:limit flags)))))

          (defn ts-get-params
            [tenant config-key role flags]
            (cond-> {:tenant tenant
                     :dataset-config-key config-key
                     :role role}
              (:ids flags)            (assoc :ids (:ids flags))
              (:range flags)          (assoc :range (:range flags))
              (:include-fields flags) (assoc :include-fields (:include-fields flags))))

          (defn ts-search-result->text
            [result]
            (let [hits (or (:hits result) [])
                  facets (:facets result)]
              (str "== TS-SEARCH "
                   "role=" (name (or (:role result) "?"))
                   " collection=" (:collection result)
                   " hits=" (count hits) "/" (or (:found-count result) "?")
                   " ==\n"
                   (clojure.string/join
                    "\n"
                    (map-indexed (fn [i hit]
                                   (let [doc (:document hit)
                                         hl (:highlights hit)
                                         snippet (or (some :snippet hl)
                                                     (some :value (mapcat :snippets hl))
                                                     "")]
                                     (str (inc i) ". "
                                          (pr-str (dissoc doc :phrase_vec
                                                          :question_vec
                                                          :triple_vec
                                                          :content_vec))
                                          (when (seq snippet)
                                            (str "\n   snippet: " snippet)))))
                                 hits))
                   (when facets
                     (str "\n\n-- facets --\n"
                          (clojure.string/join
                           "\n"
                           (map (fn [[field counts]]
                                  (str field ": "
                                       (clojure.string/join ", "
                                                            (map (fn [{:keys [value count]}]
                                                                   (str value "(" count ")"))
                                                                 counts))))
                                facets)))))))

          (defn ts-get-result->text
            [result]
            (let [docs (or (:documents result) [])]
              (str "== TS-GET "
                   "role=" (name (or (:role result) "?"))
                   " collection=" (:collection result)
                   " found=" (or (:found-count result) (count docs))
                   " ==\n"
                   (clojure.string/join
                    "\n\n"
                    (map (fn [doc]
                           (with-out-str
                             (clojure.pprint/pprint
                              (dissoc doc :phrase_vec :question_vec
                                      :triple_vec :content_vec))))
                         docs)))))

          (defn ts-retrieve-params
            [tenant config-key flags]
            (cond-> {:tenant tenant
                     :dataset-config-key config-key}
              (:queries flags)            (assoc :queries (:queries flags))
              (:q flags)                  (assoc :q (:q flags))
              (:limit flags)              (assoc :limit (:limit flags))
              (:retrieve-top-k flags)     (assoc :retrieve-top-k (:retrieve-top-k flags))
              (:max-per-document flags)   (assoc :max-per-document (:max-per-document flags))
              (:metadata-only flags)      (assoc :metadata-only (:metadata-only flags))
              (:query-aware-boost flags)  (assoc :query-aware-boost (:query-aware-boost flags))
              (:rerank-with-colbert flags) (assoc :rerank-with-colbert (:rerank-with-colbert flags))
              (:auto-filter flags)        (assoc :auto-filter (:auto-filter flags))
              (:enrichment-types flags)   (assoc :enrichment-types (:enrichment-types flags))
              (:title-fields flags)       (assoc :title-fields (:title-fields flags))
              (:doc-title-chunk-fanout flags) (assoc :doc-title-chunk-fanout (:doc-title-chunk-fanout flags))
              (:auto-filter-rules flags)  (assoc :auto-filter-rules (:auto-filter-rules flags))
              (:merge-mode flags)         (assoc :merge-mode (:merge-mode flags))
              (:rrf-k flags)              (assoc :rrf-k (:rrf-k flags))))

          (defn retrieved-chunk-label
            "Compact label for a chunk returned by the retrieval skill.
             Uses kebab-case keys (:chunk-id, :doc-num) — note: the
             skill normalizes some fields, but raw chunks may also have
             snake-case :chunk_id / :doc_num, so try both."
            [c]
            (let [cid (or (:chunk-id c) (:chunk_id c))
                  doc-num (or (:doc-num c) (:doc_num c))
                  idx (or (:chunk-index c) (:chunk_index c))
                  title (or (:title c)
                            (get-in c [:_doc :title]))
                  title-trim (when title
                               (if (> (count title) 36)
                                 (str (subs title 0 35) "...")
                                 title))]
              (str cid
                   (when title-trim (str " \"" title-trim "\""))
                   (when (or doc-num (some? idx))
                     (str " [" (or doc-num "?")
                          (when (some? idx) (str "#" idx))
                          "]")))))

          (defn ts-retrieve-result->text
            [result]
            (let [chunks (or (:chunks result) [])
                  attr (:search-attribution result)]
              (str "== TS-RETRIEVE "
                   "queries=" (pr-str (:queries result))
                   " chunks=" (count chunks)
                   " ==\n"
                   "attribution: " (pr-str attr) "\n\n"
                   (clojure.string/join
                    "\n"
                    (map-indexed
                     (fn [i c]
                       (str (inc i) ". " (retrieved-chunk-label c)
                            " types=" (pr-str (or (:search-types c) []))
                            " hits=" (or (:hit-count c) 0)
                            (when-let [rr (:rerank-score c)]
                              (str " rerank=" rr))))
                     chunks)))))

          (defn agent-budget-benchmark-eval
            [tenant config-root config-key cli-opts]
            (str "(require 'digdir.tools.diagnostics)"
                 "(digdir.tools.diagnostics/agent-budget-benchmark "
                 (pr-str {:tenant tenant
                          :config-root config-root
                          :config-key config-key
                          :cli-opts cli-opts})
                 ")"
                 "(System/exit 0)"))

          (defn run-command-live
            ([cmd]
             (run-command-live nil cmd))
            ([dir cmd]
            (let [pb (ProcessBuilder. ^java.util.List (java.util.ArrayList. ^java.util.Collection cmd))
                  _ (when dir
                      (.directory pb (java.io.File. dir)))
                  proc (.start pb)
                  consume-stream (fn [stream on-line]
                                   (let [sb (StringBuilder.)]
                                     (with-open [reader (java.io.BufferedReader.
                                                         (java.io.InputStreamReader. stream))]
                                       (loop []
                                         (if-let [line (.readLine reader)]
                                           (do
                                             (.append sb line)
                                             (.append sb "\n")
                                             (when on-line
                                               (on-line line))
                                             (recur))
                                           (str sb))))))
                  stdout-fut (future (consume-stream (.getInputStream proc) nil))
                  stderr-fut (future (consume-stream (.getErrorStream proc)
                                                    (fn [line]
                                                      (println line)
                                                      (flush))))
                  exit (.waitFor proc)]
              {:exit exit
               :out (deref stdout-fut)
               :err (deref stderr-fut)})))

          (defn infra-error?
            [payload]
            (= :infra-unavailable (get-in payload [:error :error-type])))

          (defn print-infra-error!
            [payload]
            (let [err (:error payload)]
              (println (str "INFRA service=" (or (some-> (:service err) name) "unknown")
                            " message=" (or (:message err) "Infrastructure unavailable")))))

          (defn truncate-text
            [s n]
            (let [s (str (or s ""))]
              (if (> (count s) n)
                (str (subs s 0 (max 0 (- n 1))) "...")
                s)))

          (defn chunk-label
            [chunk]
            (let [chunk-id (:chunk-id chunk)
                  title (some-> (:title chunk) (truncate-text 36))
                  doc-num (:doc-num chunk)
                  chunk-index (:chunk-index chunk)]
              (str chunk-id
                   (when title (str " \"" title "\""))
                   (when (or doc-num (some? chunk-index))
                     (str " [" (or doc-num "?")
                          (when (some? chunk-index)
                            (str "#" chunk-index))
                          "]")))))

          (defn format-search-summary
            [entry]
            (let [queries (or (:queries entry) [])
                  query-text (if (seq queries)
                               (clojure.string/join " | " queries)
                               "(no queries)")
                  top-chunks (or (:top-chunks entry) [])]
              (str "#" (:pass entry)
                   " " (truncate-text query-text 80)
                   " hits=" (or (:result-count entry) 0)
                   (when (contains? entry :new-count)
                     (str " new=" (or (:new-count entry) 0)))
                   (when (:fallback? entry)
                     " fallback")
                   (when (seq top-chunks)
                     (str " top=[" (clojure.string/join "; " (map chunk-label top-chunks)) "]")))))

          (defn format-read-summary
            [entry]
            (let [target (cond
                           (seq (:chunk-ids entry))
                           (str "chunk-ids=" (pr-str (:chunk-ids entry)))
                           (and (:doc-num entry) (:chunk-range entry))
                           (str "doc=" (:doc-num entry) " range=" (pr-str (:chunk-range entry)))
                           (:doc-num entry)
                           (str "doc=" (:doc-num entry))
                           :else nil)
                  returned (or (:returned-chunks entry) [])]
              (str "#" (:operation entry)
                   " " (name (or (:mode entry) :unknown))
                   (when target (str " " target))
                   " returned=" (or (:returned-count entry) 0)
                   " chars=" (or (:content-length entry) 0)
                   (when (seq returned)
                     (str " -> [" (clojure.string/join "; " (map chunk-label returned)) "]")))))

          (defn print-agent-profile-details!
            [label profile]
            (let [inspection (:inspection profile)
                  searches (or (:searches inspection) [])
                  reads (or (:reads inspection) [])
                  top-hits (or (:top-retrieved-chunks inspection) [])
                  largest-read (:largest-read inspection)]
              (println (str label
                            ": " (if (:pass profile) "PASS" "FAIL")
                            " status=" (or (some-> (:latest-status profile) name) "unknown")
                            (when-let [action (:latest-action profile)]
                              (str "/" (name action)))
                            " searches=" (or (:search-passes profile) 0)
                            " reads=" (or (:read-operations profile) 0)
                            " chars=" (or (:read-content-length profile) 0)))
              (when (seq top-hits)
                (println (str "    top-hits: "
                              (clojure.string/join "; " (map chunk-label top-hits)))))
              (when (seq searches)
                (println (str "    search-path: "
                              (clojure.string/join " || " (map format-search-summary searches)))))
              (when (seq reads)
                (println (str "    reads: "
                              (clojure.string/join " || " (map format-read-summary reads)))))
              (when largest-read
                (println (str "    largest-read: " (format-read-summary largest-read))))))

          (defn chunk-result->text
            [chunk-res]
            (if (:found? chunk-res)
              (str "== CHUNK == " (:chunk-id chunk-res) "\n\n"
                   "[title] " (or (:title chunk-res) "(none)") "\n"
                   "[doc_num] " (:doc-num chunk-res) "\n"
                   "[url] " (or (:url chunk-res) "(none)") "\n"
                   "[metadata] " (:metadata chunk-res) "\n\n"
                   "== CONTENT ==\n"
                   (:content-markdown chunk-res))
              (str "No chunk found with id: " (:chunk-id chunk-res) "\n"
                   "Collections searched: " (:chunks-collection chunk-res) " " (:docs-collection chunk-res))))

          (defn parse-bool
            [v]
            (contains? #{"1" "true" "yes" "on"}
                       (clojure.string/lower-case (str (or v "false")))))

          (defn pid-alive?
            "Is this pid still running? `kill -0` sends no signal and exits 0
             while the process exists.

             Exit 1 means 'not there' OR 'not permitted', which are different
             things — but every pid here came from pgrep on our own `bb dev`
             processes, so the second cannot arise. Worth knowing before reusing
             this on a pid from somewhere else."
            [pid]
            (zero? (:exit (shell {:out :string :err :string :continue true}
                                 "kill" "-0" (str pid)))))

          (defn stop-pid!
            "Stop `pid` and CONFIRM it stopped. Returns a report map:

               {:outcome :term | :kill | :alive, :waited-ms n}

             SIGTERM first, then poll; escalate to SIGKILL if it is still
             there, then poll again. The point is the polling: `kill` exits 0
             when the signal was DELIVERED, which says nothing about whether
             the process died, and reporting success on that exit code is the
             defect this replaces (#187). A dev JVM currently ignores SIGTERM
             entirely — measured at 30s, still alive — so the escalation is
             the path that actually runs, not a rare fallback."
            [pid {:keys [term-grace-ms kill-grace-ms poll-ms]
                  :or {term-grace-ms 5000 kill-grace-ms 5000 poll-ms 250}}]
            (let [start (System/currentTimeMillis)
                  ;; (fn [] ...) not #(...): bb.edn is read as EDN, which has
                  ;; no anonymous-function reader macro.
                  elapsed (fn [] (- (System/currentTimeMillis) start))
                  wait-gone (fn [budget-ms]
                              (loop []
                                (cond
                                  (not (pid-alive? pid)) true
                                  (> (elapsed) budget-ms) false
                                  :else (do (Thread/sleep poll-ms) (recur)))))]
              (shell {:out :string :err :string :continue true} "kill" (str pid))
              (if (wait-gone term-grace-ms)
                {:outcome :term :waited-ms (elapsed)}
                (do
                  (shell {:out :string :err :string :continue true} "kill" "-9" (str pid))
                  (if (wait-gone (+ term-grace-ms kill-grace-ms))
                    {:outcome :kill :waited-ms (elapsed)}
                    {:outcome :alive :waited-ms (elapsed)})))))

          (defn resolve-from-repo-root
            "Absolutise a user-supplied path while we are still in bb's cwd.

             bb runs at the repo root — which is where the docs tell you to
             stand — but the tasks below launch their JVM with `:dir \"server\"`.
             A bare `config/foo.json` handed straight through would therefore
             resolve against `server/`, and either fail with
             FileNotFoundException on read or write to the wrong place on
             export. Resolving here fixes both. Absolute paths pass through
             unchanged, and nil stays nil so usage messages still print."
            [path]
            (when path
              (.getAbsolutePath (java.io.File. (str path)))))

          (defn ensure-datahike-file-path!
            "Abort the current task when DATAHIKE_FILE_PATH is unset.

             bb config-get / config-set / pipeline-config each spawn a
             fresh JVM that reads this env var to decide which Datahike
             directory to open. When unset the JVM silently falls through
             to the default path (./local-db/dh_bb_dev_20260418) — which
             is almost always *not* the path bb dev is using when this
             repo sets DATAHIKE_FILE_PATH in mise.local.toml. The mismatch
             writes go to a ghost DB and never reach the running server.

             The bash shells that invoke these tasks don't necessarily
             have mise activated (e.g. tooling-spawned subshells), so we
             can't rely on environment inheritance. Refuse to run instead,
             and surface the value from mise.local.toml as a copy-paste
             hint so the user can fix their shell."
            [task-name]
            (when (clojure.string/blank? (System/getenv "DATAHIKE_FILE_PATH"))
              (let [mise-content (try (slurp "mise.local.toml")
                                      (catch Exception _ nil))
                    hint-pattern (re-pattern "DATAHIKE_FILE_PATH\\s*=\\s*\"([^\"]+)\"")
                    hint (when mise-content
                           (let [m (re-find hint-pattern mise-content)]
                             (when m (second m))))]
                (binding [*out* *err*]
                  (println (str "ERROR: bb " task-name
                                " requires DATAHIKE_FILE_PATH to be set."))
                  (println "")
                  (println "Without it the spawned JVM falls back to the default")
                  (println "Datahike path, silently targeting a different DB from")
                  (println "the one bb dev is using. See ensure-datahike-file-path!")
                  (println "in bb.edn for the back-story.")
                  (println "")
                  (if hint
                    (do
                      (println "Detected DATAHIKE_FILE_PATH in mise.local.toml:")
                      (println (str "  " hint))
                      (println "")
                      (println "Fix by running via mise (preferred):")
                      (println (str "  mise exec -- bb " task-name " ..."))
                      (println "Or set the var inline for this command only:")
                      (println (str "  DATAHIKE_FILE_PATH=" hint " bb " task-name " ...")))
                    (println (str "Set DATAHIKE_FILE_PATH to the dev Datahike directory "
                                  "(e.g. ./local-db/dh_bb_dev_v1).")))
                  (println ""))
                (System/exit 2)))))

  dev {:doc "Starts the server in dev mode, BACKEND ONLY: no Electric client build, no Hyperfiddle activation token needed. Serves a prebuilt client if one exists (run `bb build-client` once), and tells you what to run if not. For UI work with hot reload use `bb dev-fullstack`. (#330)"
       :task (run '-dev {:parallel true})}
  dev-fullstack {:doc "Starts the server in dev mode WITH the Electric client watch build — what `bb dev` did before #330. Needs the Hyperfiddle activation token; a new worktree may prompt you to activate. Use this for UI development."
                 :task (run '-dev-fullstack {:parallel true})}
  build-client {:doc "Build the Electric client once, as a :prod release bundle. Needs NO activation token — the Electric build hook is on the :dev build only (measured: docs/investigations/330-dev-client-decoupling-measurement.md). Takes ~100s. Writes resources/public/admin_app/js, which the :dev watch build also writes, so the two overwrite each other."
                :task (clojure {:dir "server"} "-X:build:prod build-client")}
         server-dev {:doc "Starts server in dev mode, backend only (see `bb dev`)"
                     :task (run '-server-dev {:parallel true})}
         server-dev-fullstack {:doc "Starts server in dev mode with the client watch build (see `bb dev-fullstack`)"
                               :task (run '-server-dev-fullstack {:parallel true})}
         port-forward {:doc "Sets up port forwarding to test accessories"
                       :task (run '-port-forward {:parallel true})}
         kill-all {:doc "Kill the SSH port-forwards started by `bb port-forward` (Typesense 8108 prod / 8208 test / 8308 dev, Postgres 5432). Only kills our own tunnels; anything else holding the port is reported and left alone."
                   :task (do
                           (println "\nChecking for processes on forwarded ports...")
                           (doseq [[port name] [[8108 "Typesense prod"]
                                                [8208 "Typesense test"]
                                                [8308 "Typesense dev"]
                                                [5432 "Postgres"]]]
                             (let [result (shell {:out :string :continue true}
                                                "bash" "-c"
                                                (str "lsof -ti :" port " 2>/dev/null"))
                                   pids (when (zero? (:exit result))
                                          (clojure.string/split-lines (:out result)))]
                               (if (seq pids)
                                 (do
                                   (println (str "\n[" name " - Port " port "]"))
                                   ;; A BUSY PORT DOES NOT MEAN WE PUT SOMETHING THERE.
                                   ;; On macOS a published container port is held by Colima's
                                   ;; ssh multiplexer, which is ALSO named `ssh` - so the old
                                   ;; unconditional `kill -9` on whatever lsof returned would
                                   ;; take down every local container. Match our own tunnel
                                   ;; positively and leave anything else alone.
                                   (let [described (for [pid pids]
                                                     (let [{:keys [exit out]}
                                                           (shell {:out :string :continue true}
                                                                  "bash" "-c"
                                                                  (str "ps -p " pid " -o args= | tail -n 1"))]
                                                       {:pid pid
                                                        :args (if (zero? exit)
                                                                (clojure.string/trim out) "")}))
                                         ours? (fn [{:keys [args]}]
                                                 (and (clojure.string/includes? args "ssh")
                                                      (re-find (re-pattern (str "-L\\s*" port ":localhost:"))
                                                               args)))
                                         mine (filter ours? described)
                                         others (remove ours? described)]
                                     (doseq [{:keys [pid args]} others]
                                       (println (str "  \u26a0 SKIPPED " pid " - not a bb port-forward: " args)))
                                     (if (seq mine)
                                       (do
                                         (doseq [{:keys [pid args]} mine]
                                           (println (str "  " pid " " args)))
                                         (shell "bash" "-c"
                                                (str "kill -9 "
                                                     (clojure.string/join " " (map :pid mine))))
                                         (println (str "  ✓ Killed " (count mine) " forward(s)")))
                                       (println "  nothing of ours to kill"))))
                                 (println (str "[" name " - Port " port "] No process found")))))
                           (println "\n✓ Done checking all ports\n"))}

         ;; Find running dev JVMs by their main-fn signature
         ;; (`clojure.run.exec dev/-main`). Each row carries pid, uptime,
         ;; and the worktree the JVM was launched from (via lsof cwd).
         ;; Shared helper used by `dev-ps` and `dev-stop`.
         ;;
         ;; The pattern is a PREFIX and that is load-bearing since #330: it
         ;; matches both `dev/-main` (`bb dev`) and `dev/-main-fullstack`
         ;; (`bb dev-fullstack`). Anchoring it with `$` would silently stop
         ;; finding fullstack JVMs — they would still be running, and this
         ;; would report none.
         dev-ps {:doc "List running `bb dev` / `bb dev-fullstack` instances (pid, uptime, worktree)"
                 :task
                 (let [{:keys [out]} (shell {:out :string :continue true}
                                            "bash" "-c"
                                            "pgrep -f 'clojure.run.exec dev/-main' || true")
                       pids (->> (clojure.string/split-lines out)
                                 (map clojure.string/trim)
                                 (remove clojure.string/blank?))]
                   (if (empty? pids)
                     (println "No running `bb dev` / `bb dev-fullstack` instances found.")
                     (do
                       (println (format "%-7s %-12s %s" "PID" "UPTIME" "WORKTREE"))
                       (doseq [pid pids]
                         (let [etime (-> (shell {:out :string :continue true}
                                                "bash" "-c"
                                                (str "ps -o etime= -p " pid))
                                         :out clojure.string/trim)
                               cwd (-> (shell {:out :string :continue true}
                                              "bash" "-c"
                                              (str "lsof -p " pid " 2>/dev/null"
                                                   " | awk '$4==\"cwd\" {print $NF}'"))
                                       :out clojure.string/trim)]
                           (println (format "%-7s %-12s %s" pid etime (or (not-empty cwd) "?"))))))))}

         dev-stop {:doc "Interactively stop running `bb dev` / `bb dev-fullstack` instances. Confirms each one actually stopped, escalating SIGTERM -> SIGKILL, and exits non-zero if any survived (#187)."
                   :task
                   (let [{:keys [out]} (shell {:out :string :continue true}
                                              "bash" "-c"
                                              "pgrep -f 'clojure.run.exec dev/-main' || true")
                         pids (->> (clojure.string/split-lines out)
                                   (map clojure.string/trim)
                                   (remove clojure.string/blank?))
                         rows (mapv (fn [pid]
                                      (let [etime (-> (shell {:out :string :continue true}
                                                             "bash" "-c"
                                                             (str "ps -o etime= -p " pid))
                                                      :out clojure.string/trim)
                                            cwd (-> (shell {:out :string :continue true}
                                                           "bash" "-c"
                                                           (str "lsof -p " pid " 2>/dev/null"
                                                                " | awk '$4==\"cwd\" {print $NF}'"))
                                                    :out clojure.string/trim)]
                                        {:pid pid :etime etime
                                         :cwd (or (not-empty cwd) "?")}))
                                    pids)]
                     (cond
                       (empty? rows)
                       (println "No running `bb dev` / `bb dev-fullstack` instances found.")

                       :else
                       (do
                         (println (format "%-4s %-7s %-12s %s" "#" "PID" "UPTIME" "WORKTREE"))
                         (doseq [[i row] (map-indexed vector rows)]
                           (println (format "%-4s %-7s %-12s %s"
                                            (str (inc i))
                                            (:pid row) (:etime row) (:cwd row))))
                         (print "\nWhich to stop? (comma-separated #s, 'all', or empty to cancel): ")
                         (flush)
                         (let [input (clojure.string/trim (or (read-line) ""))
                               selection (cond
                                           (clojure.string/blank? input) #{}
                                           (= "all" (clojure.string/lower-case input))
                                           (set (range 1 (inc (count rows))))
                                           :else
                                           (->> (clojure.string/split input (re-pattern ","))
                                                (map clojure.string/trim)
                                                (keep (fn [s]
                                                        (try (Integer/parseInt s)
                                                             (catch Exception _ nil))))
                                                (filter (fn [n] (and (pos? n) (<= n (count rows)))))
                                                set))
                               targets (->> rows
                                            (map-indexed vector)
                                            (filter (fn [[i _]] (contains? selection (inc i))))
                                            (map second))]
                           (if (empty? targets)
                             (println "Nothing selected; no processes stopped.")
                             (let [results
                                   (doall
                                     (for [{:keys [pid cwd]} targets]
                                       (let [{:keys [outcome waited-ms]} (stop-pid! pid {})]
                                         (println
                                           (case outcome
                                             :term (format "  ✓ %s stopped after %sms (SIGTERM) (%s)"
                                                           pid waited-ms cwd)
                                             :kill (format "  ✓ %s stopped after %sms — SIGTERM ignored, escalated to SIGKILL (%s)"
                                                           pid waited-ms cwd)
                                             :alive (format "  ✗ %s STILL RUNNING after SIGTERM and SIGKILL (%sms) (%s)"
                                                            pid waited-ms cwd)))
                                         outcome)))]
                               ;; The tick is earned by the process being gone,
                               ;; not by a signal having been delivered (#187),
                               ;; and a survivor is worth a non-zero exit: it
                               ;; still holds the port the caller wanted back.
                               (when (some #{:alive} results)
                                 (println "\nAt least one process survived. It still holds its port —")
                                 (println "check with: lsof -nP -iTCP:<port> -sTCP:LISTEN")
                                 (System/exit 1))))))))}

         ;; Port forwarding tasks
         -port-forward {:depends [-port-forward-test-typesense
                                  -port-forward-test-postgres]}
         -port-forward-dev-typesense (do
           (println "→ dev Typesense will be reachable at localhost:8308"
                    "(set services.typesense.api-host accordingly)")
