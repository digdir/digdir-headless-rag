         config-get {:doc "Get a resolved config value from the current config DB (usage: bb config-get <path> <tenant> <config-root> <config-key> [--dataset-id <id>] [--agent-id <id>] [--pipeline-id <id>], example: bb config-get skills.rerank.top-k digdir runtime default --dataset-id public-docs)"
                     :task (do
                             (ensure-datahike-file-path! "config-get")
                             (let [args *command-line-args*
                                 path (first args)
                                 tenant (second args)
                                 config-root (nth args 2 nil)
                                 config-key (nth args 3 nil)
                                 flag-val (fn [flag]
                                            (loop [xs (drop 4 args)]
                                              (cond
                                                (empty? xs) nil
                                                (= flag (first xs)) (second xs)
                                                :else (recur (rest xs)))))
                                 dataset-id (flag-val "--dataset-id")
                                 agent-id (flag-val "--agent-id")
                                 pipeline-id (flag-val "--pipeline-id")]
                             (if (and path tenant config-root config-key)
                               (clojure {:dir "server"}
                                        "-M:diagnostics"
                                        "-e"
                                        (str "(require 'digdir.tools.config)"
                                             "(digdir.tools.config/get-value "
                                             (pr-str (cond-> {:path path
                                                              :root config-root
                                                              :tenant tenant
                                                              :tenant-config-key config-key}
                                                       dataset-id (assoc :dataset-id dataset-id)
                                                       agent-id (assoc :agent-id agent-id)
                                                       pipeline-id (assoc :pipeline-id pipeline-id)))
                                             ")"
                                             "(System/exit 0)"))
                               (do
                                 (println "Usage: bb config-get <path> <tenant> <config-root> <config-key> [--dataset-id <id>] [--agent-id <id>] [--pipeline-id <id>]")
                                 (println "Example: bb config-get skills.rerank.context.top-k ka runtime default")
                                 (println "Example: bb config-get skills.rerank.top-k digdir runtime default --dataset-id public-docs")))))}

         config-set {:doc "Set a config value on the current config DB. After the write, touches a marker file that any running bb dev polls every 5s and best-effort POSTs to /api/debug/config/refresh to invalidate bb dev's in-memory snapshot immediately. (usage: bb config-set <path> <edn-value> <tenant> <config-root> <config-key>, example: bb config-set skills.retrieval.top-k 100 ka runtime default)"
                     :task (do
                             (ensure-datahike-file-path! "config-set")
                             (let [args *command-line-args*
                                 path (first args)
                                 value-str (second args)
                                 tenant (nth args 2 nil)
                                 config-root (nth args 3 nil)
                                 config-key (nth args 4 nil)]
                             (if (and path value-str tenant config-root config-key)
                               (let [value (read-edn value-str)
                                     root (keyword config-root)]
                                 (clojure {:dir "server"}
                                          "-M:diagnostics"
                                          "-e"
                                          (str "(require '[digdir.config.core :as config-core]"
                                               "         '[digdir.config.db :as config-db]"
                                               "         '[digdir.config.cache-invalidation :as ci])"
                                               "(let [conn (config-db/get-conn)"
                                               "      master-key (config-core/get-master-key)"
                                               "      tenant " (pr-str tenant)
                                               "      root " (pr-str root)
                                               "      config-key " (pr-str config-key)
                                               "      node (or (config-db/get-config-node-by-tenant-config-key @conn tenant root config-key)"
                                               "               (throw (ex-info \"Config node not found\" {:tenant tenant :root root :tenant-config-key config-key})))"
                                               "      result (config-db/set-node-value! conn"
                                               "                                        {:root root"
                                               "                                         :tenant tenant"
                                               "                                         :node-id (:config.node/id node)"
                                               "                                         :path " (pr-str path)
                                               "                                         :value " (pr-str value)
                                               "                                         :master-key master-key})"
                                               "      marker-path (ci/touch-marker!)]"
                                               "  (prn {:result result"
                                               "        :tenant tenant"
                                               "        :root root"
                                               "        :tenant-config-key config-key"
                                               "        :path " (pr-str path)
                                               "        :marker marker-path})"
                                               "  (System/exit 0))"))
                                 ;; Best-effort HTTP push so a running bb dev refreshes its
                                 ;; in-memory snapshot immediately (sub-second), without
                                 ;; waiting for the file-marker poll. Silent on failure;
                                 ;; the marker file is the durable signal.
                                 (when-let [base-url (System/getenv "RAG_API_BASE_URL")]
                                   (when-let [debug-key (System/getenv "RAG_DEBUG_API_KEY")]
                                     (try
                                       (shell {:continue true :out :string :err :string}
                                              "curl" "-fsS" "-m" "1" "-X" "POST"
                                              "-H" (str "X-Debug-Api-Key: " debug-key)
                                              (str base-url "/api/debug/config/refresh"))
                                       (catch Exception _ nil)))))
                               (do
                                 (println "Usage: bb config-set <path> <edn-value> <tenant> <config-root> <config-key>")
                                 (println "Example: bb config-set skills.rerank.context.relative-score-threshold 0.85 ka runtime default")))))}

