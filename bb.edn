         agent-budget-report {:doc "Run agent-budget-benchmark and print a compact comparison table (usage: bb agent-budget-report <tenant> <config-root> <config-key> --suite <file.edn> [agent-budget-benchmark flags...])"
                              :task (let [args *command-line-args*
