         dump-import {:doc "Import a system from a dump folder. After the import, touches the config-cache-invalidation marker so any running bb dev refreshes its in-memory snapshot at the next poll tick (≤5s). (usage: bb dump-import <dir> [--on-conflict skip|overwrite])"
                      :task (let [args *command-line-args*
                                  input-dir (resolve-from-repo-root (first args))
                                  on-conflict (keyword
                                               (loop [xs (rest args) out "skip"]
                                                 (if (empty? xs)
                                                   out
                                                   (let [[x y & more] xs]
                                                     (if (= "--on-conflict" x)
                                                       (recur more y)
                                                       (recur (rest xs) out))))))]
                              (if input-dir
                                (clojure {:dir "server"}
                                         "-M:dev"
                                         "-e"
                                         (str "(require '[digdir.import-export.dump :as dump]"
                                              "         '[digdir.config.db :as config-db]"
                                              "         '[digdir.data.db :as db]"
                                              "         '[digdir.config.core :as config-core]"
                                              "         '[digdir.config.cache-invalidation :as ci])"
                                              "(let [result (dump/import-system (config-db/get-conn) (db/get-conn) "
                                              (pr-str input-dir)
                                              " {:master-key (config-core/get-master-key)"
                                              " :on-conflict " (pr-str on-conflict) "})]"
                                              "  (ci/touch-marker!)"
                                              "  (prn result)"
                                              "  (System/exit 0))"))
                                (do
                                  (println "Usage: bb dump-import <dir> [--on-conflict skip|overwrite]")
                                  (println "Example: bb dump-import dumps/2026-05-08T20-04-55Z"))))}

