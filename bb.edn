         rerank-benchmark-report {:doc "Run rerank-benchmark and print a compact per-case table (usage: bb rerank-benchmark-report <tenant> <config-root> <config-key> --suite <file.edn> [rerank-benchmark flags...])"
                                  :task (let [args *command-line-args*
                                              tenant (nth args 0 nil)
                                              config-root (nth args 1 nil)
                                              config-key (nth args 2 nil)
                                              cli-opts (vec (drop 3 args))
                                              fail-on-gate (parse-bool (loop [xs cli-opts out "false"]
                                                                         (if (empty? xs)
                                                                           out
                                                                           (let [[x y & more] xs]
                                                                             (if (= "--fail-on-gate" x)
                                                                               (recur more y)
                                                                               (recur (rest xs) out))))))
                                              cmd (vec (concat ["bb" "rerank-benchmark" tenant config-root config-key]
                                                               cli-opts))
                                              result (apply shell {:out :string :err :out :continue true} cmd)]
                                          (when-not (zero? (:exit result))
                                            (throw (ex-info "rerank-benchmark failed" {:exit (:exit result)
                                                                                       :output (:out result)})))
                                          (let [payload (parse-last-edn-line (:out result))
                                                rows (or (:results payload) [])
                                                summary (:summary payload)
                                                lang-summary (or (:summary-by-language payload) {})
                                                source-summary (or (:summary-by-source-slice payload) {})
                                                print-slice-table!
                                                (fn [label m]
                                                  (when (seq m)
                                                    (println "")
                                                    (println (str label " | cases | in_rerank | in_context | mrr | p50_rank"))
                                                    (println (str (apply str (repeat (count label) "-"))
                                                                  "|------|-----------|------------|-----|---------"))
                                                    (doseq [[k s] m]
                                                      (println (str (if (nil? k) "-" (name k)) " | "
                                                                    (:cases s) " | "
                                                                    (:golden-present-in-retrank s) " | "
                                                                    (:golden-present-in-context s) " | "
                                                                    (:mrr s) " | "
                                                                    (:p50-rank s))))))]
                                            (when (infra-error? payload)
                                              (print-infra-error! payload)
                                              (System/exit 2))
                                            (println "id | source | lang | merged | retrieved | rerank | context | pass")
                                            (println "---|--------|------|--------|-----------|--------|---------|-----")
                                            (doseq [r rows]
                                              (let [g (first (:golden r))
                                                    source-col (or (some-> (:source-slice r) name) "-")
                                                    lang-col (or (some-> (:language r) name) "-")
                                                    merged-col (if (:error r) "ERR" (or (:merged-position g) "-"))
                                                    retrieved-col (if (:error r) "ERR" (or (:retrieved-position g) (or (:candidate-position g) "-")))
                                                    rerank-col (if (:error r) "ERR" (or (:rerank-position g) "-"))
                                                    context-col (if (:error r) "ERR" (or (:context-position g) "-"))
                                                    pass-col (if (:error r) "ERROR" (if (:pass r) "PASS" "FAIL"))]
                                                (println (str (:id r) " | "
                                                              source-col " | "
                                                              lang-col " | "
                                                              merged-col " | "
                                                              retrieved-col " | "
                                                              rerank-col " | "
                                                              context-col " | "
                                                              pass-col))))
                                            (print-slice-table! "source" source-summary)
                                            (print-slice-table! "lang  " lang-summary)
                                            (println "")
                                            (println (str "gate-pass=" (:gate-pass summary)
                                                          " cases=" (:cases summary)
                                                          " failed=" (:cases-failed summary)
                                                          " mrr=" (:mrr summary)))
                                            (when (and fail-on-gate (not (:gate-pass summary)))
                                              (throw (ex-info "Rerank benchmark gate failed" {:summary summary})))))}

