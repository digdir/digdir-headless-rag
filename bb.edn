                                                         ") "
                                                         "[:tenant :root]))"
                                                         "(System/exit 0)"))
                                           (do
                                             (println "Usage: bb bootstrap-dataset-tree <tenant> <config-key> <pipeline-id> [dataset-id]")
                                             (println "Example: bb bootstrap-dataset-tree ka dev kudos"))))} 

         bootstrap-deployment-target-topology {:doc "Bootstrap the deployment target topology for digdir/public-docs and public-sector-knowledge/kudos"
                                               :task (clojure {:dir "server"}
                                                              "-M:dev"
                                                              "-e"
                                                              (str "(require '[digdir.data.db :as data-db]"
                                                                   "         '[digdir.config.ops.topology :as ops-topology]"
                                                                   "         '[digdir.config.core :as config-core])"
                                                                   "(let [result (ops-topology/bootstrap-deployment-target-topology! "
                                                                   "               (data-db/get-conn) "
                                                                   "               {:master-key (config-core/get-master-key)})]"
                                                                   "  (prn (select-keys result [:target-datasets :target-pipelines :materialization-defaults])))"
                                                                   "(System/exit 0)"))}

         seed-target-materialization-defaults {:doc "Seed missing Dataset-root materialization defaults for the deployment target tenants (usage: bb seed-target-materialization-defaults [config-key])"
                                               :task (let [args *command-line-args*
                                                           config-key (nth args 0 "dev")]
                                                       (clojure {:dir "server"}
                                                                "-M:dev"
                                                                "-e"
                                                                (str "(require '[digdir.data.db :as data-db]"
                                                                     "         '[digdir.config.ops.materialization :as ops-materialization]"
                                                                     "         '[digdir.config.core :as config-core])"
                                                                     "(prn (ops-materialization/seed-target-materialization-defaults! "
                                                                     "(data-db/get-conn) "
                                                                     "{:master-key (config-core/get-master-key)"
                                                                     " :config-key " (pr-str config-key) "}))"
                                                                     "(System/exit 0)")))} 

         preview-target-tenant-retirement {:doc "Read-only preview of the original-tenant retirement scope (usage: bb preview-target-tenant-retirement [config-key])"
                                           :task (let [args *command-line-args*
                                                       config-key (nth args 0 "dev")]
                                                   (clojure {:dir "server"}
                                                            "-M:dev"
                                                            "-e"
                                                            (str "(require '[digdir.data.db :as data-db]"
                                                                 "         '[digdir.config.ops.retirement :as ops-retirement])"
                                                                 "(prn (ops-retirement/preview-tenant-retirement! "
                                                                 "(data-db/get-conn) "
                                                                 "{:config-key " (pr-str config-key) "}))"
                                                                 "(System/exit 0)")))} 

         retire-source-tenants {:doc "Retire the original source tenants after target verification (usage: bb retire-source-tenants [config-key] [conversation-strategy] [--apply])"
                                :task (let [args *command-line-args*
                                            positional-args (filter (fn [arg]
                                                                      (not (clojure.string/starts-with? arg "--")))
                                                                    args)
                                            config-key (or (first positional-args) "dev")
                                            conversation-strategy (keyword (or (second positional-args)
                                                                              "retain"))
                                            dry-run? (not (some #{"--apply"} args))]
                                        (clojure {:dir "server"}
                                                 "-M:dev"
                                                 "-e"
                                                 (str "(require '[digdir.data.db :as data-db]"
                                                      "         '[digdir.config.ops.retirement :as ops-retirement])"
                                                      "(prn (ops-retirement/retire-source-tenants! "
                                                      "(data-db/get-conn) "
                                                      "{:config-key " (pr-str config-key)
                                                      " :conversation-strategy " (pr-str conversation-strategy)
                                                      " :dry-run? " dry-run? "}))"
                                                      "(System/exit 0)")))} 

         backfill-schema {:doc "Backfill content_length on chunks and total_chunks on documents for existing collections (usage: bb backfill-schema <tenant> <config-key> <pipeline-id>)"
                          :task (let [args *command-line-args*
                                      tenant (nth args 0 nil)
                                      config-key (nth args 1 nil)
                                      pipeline (nth args 2 nil)]
                                  (if (and tenant config-key pipeline)
                                    (clojure {:dir "server"}
                                             "-M:dev"
                                             "-e"
                                             (str "(require '[digdir.docs.pipeline.storage :as storage]"
                                                  "         '[digdir.config.db :as config-db]"
                                                  "         '[digdir.config.core :as config-core]"
                                                  "         '[digdir.pipeline.collections :as collections])"
                                                  "(let [conn (config-db/get-conn)"
                                                  "      db @conn"
                                                  "      master-key (config-core/get-master-key)"
                                                  "      pipeline-config (config-db/get-pipeline db "
                                                  (pr-str tenant) " " (pr-str config-key) " " (pr-str pipeline) " master-key)"
                                                  "      _ (when-not pipeline-config (throw (ex-info \"Pipeline not found\" {})))"
                                                  "      colls (collections/get-or-generate-collection-names pipeline-config)"
                                                  "      opts {:tenant " (pr-str tenant) " :config-key " (pr-str config-key) "}]"
                                                  "  (println \"Backfilling content_length on chunks:\" (:chunks-collection colls))"
                                                  "  (println (storage/backfill-content-length! (:chunks-collection colls) opts))"
                                                  "  (println)"
                                                  "  (println \"Backfilling total_chunks on documents:\" (:docs-collection colls))"
                                                  "  (println (storage/backfill-total-chunks! (:docs-collection colls) (:chunks-collection colls) opts))"
                                                  "  (println)"
                                                  "  (println \"Done.\"))"
                                                  "(System/exit 0)"))
                                    (do
                                      (println "Usage: bb backfill-schema <tenant> <config-key> <pipeline-id>")
                                      (println "Example: bb backfill-schema ka test kudos")
                                      (println "")
                                      (println "Backfills content_length on chunks and total_chunks on documents")
                                      (println "for collections that were created before these fields were added.")
                                      (println "")
                                      (println "Smoke-run checklist:")
                                      (println "  1. Port-forward to target Typesense (bb port-forward or ssh tunnel)")
                                      (println "  2. Run: bb backfill-schema <tenant> test <pipeline-id>")
                                      (println "  3. Expect output like: {:updated N :skipped M :errors 0}")
                                      (println "  4. Re-run — second pass should show {:updated 0 :skipped N+M :errors 0}")
                                      (println "  5. Verify with: bb chunk <tenant> test <any-chunk-id> <pipeline-id>"))))}

    }}
