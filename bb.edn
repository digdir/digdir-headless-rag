                                   (apply shell "kamal" "app" "--config-file=deploy.yml" (str "--destination=" kamal-dest) "exec" "--reuse" "--interactive" rest-args)))
                               (show-destination-error "exec-server <command...>")))}

         ;; Parameterized log viewing tasks
         logs-server {:doc "View server container logs (usage: bb logs-server <destination>, e.g., bb logs-server prod)"
                     :task (let [dest (first *command-line-args*)]
                             (if dest
                               (let [kamal-dest (kamal-destination dest)]
                                 (if (= kamal-dest "prod")
                                   (shell "kamal" "app" "logs" "--config-file=deploy.yml" "--lines" "300" "--follow")
                                   (shell "kamal" "app" "logs" "--config-file=deploy.yml" (str "--destination=" kamal-dest) "--lines" "300" "--follow")))
                               (show-destination-error "logs-server")))}

         ;; Lock release tasks
         release-server-lock {:doc "Release kamal server deploy lock (usage: bb release-server-lock <destination>, e.g., bb release-server-lock prod)"
                             :task (let [dest (first *command-line-args*)]
                                     (if dest
                                       (let [kamal-dest (kamal-destination dest)]
                                         (if (= kamal-dest "prod")
                                           (shell "kamal" "lock" "release" "--config-file=deploy.yml")
                                           (shell "kamal" "lock" "release" "--config-file=deploy.yml" (str "--destination=" kamal-dest))))
                                       (show-destination-error "release-server-lock")))}

         ;; Internal server dev tasks. `-server-dev` is BACKEND ONLY and does not
         ;; depend on `-server-dev:electric`, which is the whole point of #330:
         ;; the client build needs an activation token a newcomer does not have,
         ;; and it gates nothing the backend needs. `-server-dev-fullstack` keeps
         ;; the coupled chain, token step included.
         -server-dev {:task (clojure {:dir "server"} "-X:personal/dev:dev dev/-main")}
         -server-dev-fullstack {:depends [-server-dev:electric]}
         ;; Restores the Hyperfiddle Electric activation token before the client
         ;; build runs. The token lives INSIDE the shadow build cache
         ;; (hooks3/reload-clj passes {cache-dir}/hyperfiddle.electric.token to
         ;; ensure-user-auth!, with no env override and no fallback path), so it
         ;; CANNOT be made persistent — only re-established. This covers both a
         ;; brand-new worktree and a cleared .shadow-cljs, in one code path.
         ;; NOTE: clearing .cpcache or ~/.m2 does NOT remove it — those are
         ;; sibling trees, measured, not assumed.
         -ensure-electric-token
         {:doc "Link the Electric activation token into this worktree's shadow build cache, if a source exists and the slot is empty. Never overwrites."
          :requires ([babashka.fs :as fs])
          :task (let [src (fs/path (System/getProperty "user.home")
                                   ".config" "hyperfiddle" "electric.token")
                      tgt (fs/path "server" ".shadow-cljs" "builds" "dev" "dev"
                                   "hyperfiddle.electric.token")]
                  (cond
                    ;; No source configured: silent no-op. The activation prompt
                    ;; is the correct fallback, not an error.
                    (not (fs/exists? src)) nil

                    ;; fs/exists? FOLLOWS symlinks, so a DANGLING link reads as
                    ;; absent here rather than as an occupied slot. That is
                    ;; deliberate: a dangling symlink is a file-shaped absence.
                    (fs/exists? tgt) nil

                    :else
                    (do
                      ;; Clear a dangling link before relinking; create-sym-link
                      ;; fails on an existing path.
                      (when (fs/sym-link? tgt) (fs/delete tgt))
                      (fs/create-dirs (fs/parent tgt))
                      (fs/create-sym-link tgt src)
                      (println "Electric activation token linked from" (str src)))))}

         -server-dev:electric {:depends [-ensure-electric-token]
                               :task (clojure {:dir "server"} "-X:personal/dev:dev dev/-main-fullstack")}

         import-kudos {:doc "Import kudos documents"
                       :task (clojure {:dir "server"} "-X:personal/dev:dev electric-starter-app.document-loading/-main")}

         import-kudos-doc {:doc "Import a single Kudos document by ID (usage: bb import-kudos-doc <doc-id>)"
                           :task (clojure {:dir "server"}
                                          "-X:personal/dev:dev"
                                          "electric-starter-app.document-loading/-main-single"
                                          ":doc-id"
                                          (first *command-line-args*))}

         chunk {:doc "Fetch and display a chunk via local API endpoint (usage: bb chunk <tenant> <env> <chunk-id> [pipeline], default pipeline: kudos)"
                :task (let [args *command-line-args*]
                        (if (>= (count args) 3)
                          (let [result (call-debug-endpoint-edn
                                        "/api/debug/chunk"
                                        (assoc (dataset-ref-params (nth args 0)
                                                                   (nth args 1)
                                                                   (or (nth args 3 nil) "kudos"))
                                               :chunk-id (nth args 2)))]
                            (println (chunk-result->text result)))
                          (do
                            (println "Usage: bb chunk <tenant> <env> <chunk-id> [pipeline]")
                            (println "Default pipeline: kudos")
                            (println "Example: bb chunk ka dev 792beec82d38"))))}

         ts-search {:doc "Search a Typesense collection via local API endpoint (usage: bb ts-search <tenant> <env> <role> \"<query>\" [--query-by ...] [--filter-by ...] [--diataxis <values>] [--diataxis-strict] [--sort-by ...] [--facet-by ...] [--include-fields f1,f2] [--limit N])"
                    :task (let [args *command-line-args*]
                            (if (>= (count args) 4)
                              (let [tenant (nth args 0)
                                    env (nth args 1)
                                    role (nth args 2)
                                    q (nth args 3)
                                    flags (parse-cli-flags (drop 4 args))
                                    params (ts-search-params tenant env role q flags)
                                    result (call-debug-endpoint-edn
                                            "/api/debug/typesense-search" params)]
                                (println (ts-search-result->text result)))
                              (do
                                (println "Usage: bb ts-search <tenant> <env> <role> \"<query>\" [flags]")
                                (println)
                                (println "Roles:")
                                (println "  docs | chunks | phrases")
                                (println "  enrichment/hypothetical-questions")
                                (println "  enrichment/verified-phrases")
                                (println "  enrichment/fact-assertions")
                                (println "  enrichment/knowledge-graph")
                                (println)
                                (println "Flags:")
                                (println "  --query-by <fields>       Override default query_by per role")
                                (println "  --filter-by <expr>         Raw Typesense filter expression")
                                (println "  --diataxis <values>        Filter by diataxis value(s) (comma-sep).")
                                (println "                             Permissive by default: ALSO matches docs")
                                (println "                             with no diataxis value set (~32% of corpus")
                                (println "                             lacks the frontmatter field).")
                                (println "                             Combined with --filter-by via &&.")
                                (println "                             Universe: explanation, how-to-guides, reference, tutorials")
                                (println "  --diataxis-strict          Require explicit diataxis match (exclude")
                                (println "                             docs with no diataxis value).")
                                (println "  --sort-by <expr>           Raw Typesense sort expression")
                                (println "  --facet-by <fields>        Comma-separated facet fields")
                                (println "  --include-fields <list>    Explicit projection (default: small fields per role)")
                                (println "  --limit <n>                Per-page limit, default 20, max 100")
                                (println)
                                (println "Examples:")
                                (println "  bb ts-search digdir public-docs chunks \"altinn 3\"")
                                (println "  bb ts-search digdir public-docs chunks \"*\" --facet-by orgs_long --limit 0")
                                (println "  bb ts-search digdir public-docs docs \"subscription\" --diataxis how-to-guides")
                                (println "  bb ts-search digdir public-docs docs \"data\" --diataxis reference --diataxis-strict")
                                (println "  bb ts-search digdir public-docs enrichment/hypothetical-questions \"Når ble Altinn 3 lansert?\""))))}

         ts-get {:doc "Fetch documents by id from a Typesense collection (usage: bb ts-get <tenant> <env> <role> --ids <id1,id2,...> | --range <doc_num>:<start>-<end> [--include-fields f1,f2])"
                 :task (let [args *command-line-args*]
                         (if (>= (count args) 3)
                           (let [tenant (nth args 0)
                                 env (nth args 1)
                                 role (nth args 2)
                                 flags (parse-cli-flags (drop 3 args))
                                 params (ts-get-params tenant env role flags)
                                 result (call-debug-endpoint-edn
                                         "/api/debug/typesense-get" params)]
                             (println (ts-get-result->text result)))
                           (do
                             (println "Usage: bb ts-get <tenant> <env> <role> --ids <id1,id2,...>")
                             (println "       bb ts-get <tenant> <env> chunks --range <doc_num>:<start>-<end>")
                             (println)
                             (println "Roles: same enum as bb ts-search")
                             (println)
                             (println "Flags:")
                             (println "  --ids <id1,id2,...>      Comma-separated IDs (doc_num for docs, chunk_id otherwise)")
                             (println "  --range <doc>:<s>-<e>    Chunk-index range, only valid for role=chunks")
                             (println "  --include-fields <list>  Explicit projection (default: small fields per role)")
                             (println)
                             (println "Examples:")
                             (println "  bb ts-get digdir public-docs chunks --ids abc123,def456")
                             (println "  bb ts-get digdir public-docs chunks --ids abc123 --include-fields content_markdown")
                             (println "  bb ts-get digdir public-docs chunks --range 42:0-9"))))}

         ts-retrieve {:doc "Run multi-strategy retrieval skill (phrase+metadata+content [+enrichments] [+ColBERT rerank]) via local API endpoint. DISABLED by default — set RAG_TS_RETRIEVE_ENABLED=true to enable. (usage: bb ts-retrieve <tenant> <env> \"<query>[,<query2>,...]\" [flags])"
                      :task (let [args *command-line-args*]
                              (if (>= (count args) 3)
                                (let [tenant (nth args 0)
                                      env (nth args 1)
                                      queries (nth args 2)
                                      flags (-> (parse-cli-flags (drop 3 args))
                                                (assoc :queries queries))
                                      params (ts-retrieve-params tenant env flags)
                                      result (call-debug-endpoint-edn
                                              "/api/debug/typesense-retrieve" params)]
                                  (println (ts-retrieve-result->text result)))
                                (do
                                  (println "Usage: bb ts-retrieve <tenant> <env> \"<query>[,<query2>,...]\" [flags]")
                                  (println)
                                  (println "Disabled by default. Enable with: RAG_TS_RETRIEVE_ENABLED=true")
                                  (println "(default-off is deliberate during isolation sweeps —")
                                  (println " see plans/proposed/typesense-filesystem-tools-plan.md)")
                                  (println)
                                  (println "Flags:")
                                  (println "  --limit <n>                 Per-strategy per-query cap (default 30)")
                                  (println "  --retrieve-top-k <n>        Merged-top-k cap (default 100)")
                                  (println "  --max-per-document <n>      Diversity cap (skill default ~10)")
                                  (println "  --metadata-only <bool>      Strip content_markdown (default true)")
                                  (println "  --query-aware-boost <bool>  Title/year/org boosts (default true)")
                                  (println "  --rerank-with-colbert <bool> Run ColBERT rerank pass (default false)")
                                  (println "  --auto-filter <bool>        Detect org/year filters from query (default false here)")
                                  (println "  --enrichment-types <list>   e.g. hypothetical-questions,verified-phrases,fact-assertions")
                                  (println)
                                  (println "Examples:")
                                  (println "  bb ts-retrieve digdir public-docs \"altinn 3 launch date\"")
                                  (println "  bb ts-retrieve digdir public-docs \"q1,q2,q3\" --limit 50 --retrieve-top-k 200")
                                  (println "  bb ts-retrieve digdir public-docs \"altinn\" --enrichment-types hypothetical-questions,verified-phrases"))))}

         demo-corpus {:doc "Fetch the demo NorQuAD corpus (352 Wikipedia articles + distractors) into DEMO_CORPUS_DIR (default ./demo-corpus). Nothing is checked in: NorQuAD's CC0 covers its questions and answers, not the Wikipedia prose, so the text is fetched from Wikipedia under CC BY-SA at setup. Resumable — an article already written is not refetched. (usage: bb demo-corpus [distractor-count])"
                      :task (let [dir (or (System/getenv "DEMO_CORPUS_DIR") "./demo-corpus")
                                  n (or (first *command-line-args*) "800")]
                              (println (str "  fetching demo corpus into " dir))
                              (shell (str "bb server/scripts/corpus/rehydrate_norquad.clj " dir " " n)))}
         v3-score {:doc "Score ts-retrieve against the v3-baseline cited chunks. Reports both chunk-level (strict v3) and doc-level (slice-21) recall at top-10 and top-30. When --user-intent-first-pass true, also runs an intent-only pass and merges via --union-mode (cap|interleave|rrf, default cap per slice-22 measurement). Cap mode takes --intent-cap N (default 3); RRF mode takes --union-rrf-k K (default 60). --server-side-union true delegates the union to the production retrieval skill via one debug-endpoint call (slice 23 verification). (usage: bb v3-score [--top-k 30] [--expand-queries N] [--user-intent-first-pass true] [--server-side-union true] [--union-mode cap|interleave|rrf] [--intent-cap N] [--union-rrf-k K] [--rerank-with-colbert true] [--title-fields '[\"linktitle\" \"frontmatter_title\"]'] [--doc-title-chunk-fanout 3] [--auto-filter-rules '<edn>'] [--expansion-mode blind|corpus-aware-1hop|corpus-aware-2hop] [--expansion-variant two-call|one-call] [--expansion-compare true] [--auto-filter true|false] [--enrichment-types hypothetical-questions,verified-phrases,...] [--tenant digdir] [--env public-docs] [--v3-dir <path>])"
                   :task (let [flags (parse-cli-flags *command-line-args*)
                               tenant (or (:tenant flags) "digdir")
                               env (or (:env flags) "public-docs")
                               top-k-int (Integer/parseInt (str (or (:top-k flags) "30")))
                               title-fields (or (:title-fields flags) "[\"linktitle\" \"frontmatter_title\"]")
                               chunk-content-fields (:chunk-content-fields flags)
                               chunk-metadata-fields (:chunk-metadata-fields flags)
                               retrieval-mode (:retrieval-mode flags)
                               doc-title-chunk-fanout (or (:doc-title-chunk-fanout flags) "3")
                               auto-filter-rules (:auto-filter-rules flags)
                               merge-mode (:merge-mode flags)
                               rrf-k (:rrf-k flags)
                               rerank-with-colbert (:rerank-with-colbert flags)
                               rerank-candidate-k (:rerank-candidate-k flags)
                               per-strategy-rerank (:per-strategy-rerank flags)
                               rerank-final-cap (:rerank-final-cap flags)
                               strategy-weights (:strategy-weights flags)
                               strategy-contribution-caps (:strategy-contribution-caps flags)
                               expand-queries-n (when-let [n (:expand-queries flags)]
                                                  (Integer/parseInt (str n)))
                               ;; Expansion-mode: blind (default) | corpus-aware-1hop |
                               ;; corpus-aware-2hop. Corpus-aware modes route through the
                               ;; PRF planner (passes dataset-config-key + expansion-mode).
                               expansion-mode-flag (keyword (or (:expansion-mode flags) "blind"))
                               ;; two-call (default) | one-call — corpus-aware only.
                               ;; one-call drops the blind-expansion LLM call (single
                               ;; grounding+intent call); A/B vs two-call by running
                               ;; the compare twice with each variant.
                               expansion-variant-flag (:expansion-variant flags)
                               ;; Comma-separated enrichment types to include as sibling
                               ;; search strategies (hypothetical-questions,verified-phrases,
                               ;; fact-assertions). Forwarded to the retrieve endpoint, which
                               ;; resolves them to collection names.
                               enrichment-types-flag (:enrichment-types flags)
                               ;; Auto-filter is ON by default (v3-baseline parity), but it
                               ;; runs on the (varying) expanded queries and on org-tagged
                               ;; corpora can exclude goldens — a measurement confound. Pass
                               ;; --auto-filter false to isolate (results.md Phase E, #3).
                               auto-filter-flag (str (or (:auto-filter flags) "true"))
                               ;; When true, run ALL THREE modes per question and print a
                               ;; per-mode block — the standing A/B for the tuning loop.
                               expansion-compare? (= "true" (str (:expansion-compare flags)))
                               v3-dir (or (:v3-dir flags) "plans/in-progress/target-optimal-baseline-v3")
                               qfile-re (re-pattern "^(\\d{2})-.*\\.md$")
                               chunkid-re (re-pattern "`([0-9a-f]{12})`")
                               cite-section-re (re-pattern "(?ms)^## Cited chunks\\s*$(.*?)(?=^## |\\z)")
                               h1-re (re-pattern "(?m)^#\\s+Q\\d+\\s+v\\d+\\s+[\\u2014-]\\s+(.+)$")
                               parse-cites (fn [content]
                                             (when-let [m (re-find cite-section-re content)]
                                               (set (map second (re-seq chunkid-re (second m))))))
                               parse-question (fn [content]
                                                (some-> (re-find h1-re content) second clojure.string/trim))
                               files (->> (.listFiles (java.io.File. v3-dir))
                                          (filter (fn [f] (re-matches qfile-re (.getName f))))
                                          (sort-by (fn [f] (.getName f))))
                               entries (mapv (fn [file]
                                               (let [content (slurp file)
                                                     name (.getName file)
                                                     [_ qnum] (re-find qfile-re name)]
                                                 {:qnum qnum
                                                  :question (parse-question content)
                                                  :cites (or (parse-cites content) #{})}))
                                             files)
                               _ (when (empty? entries)
                                   (throw (ex-info (str "No v3 question files matched in " v3-dir) {})))
                               ;; Bulk-lookup doc_num for every cited chunk_id. One call
                               ;; for the whole baseline. Used for doc-level scoring
                               ;; (see plans/in-progress/target-optimal-baseline-v3/21-*).
                               all-cite-ids (->> entries (mapcat (comp seq :cites)) distinct vec)
                               ;; The typesense-get endpoint caps per_page at
                               ;; min(100, count ids), so a single bulk lookup of
                               ;; >100 cite-ids silently truncates and collapses
                               ;; doc-level recall to 0/0 for the unresolved
                               ;; queries. Batch into groups of 100 and merge.
                               chunk->doc (into {}
                                            (mapcat
                                             (fn [id-batch]
                                               (let [resp (call-debug-endpoint-edn
                                                           "/api/debug/typesense-get"
                                                           {:tenant tenant
                                                            :dataset-config-key env
                                                            :role "chunks"
                                                            :ids (clojure.string/join "," id-batch)
                                                            :include-fields "chunk_id,doc_num"})]
                                                 (map (juxt :chunk_id :doc_num)
                                                      (or (:documents resp) []))))
                                             (partition-all 100 all-cite-ids)))
                               ;; Augment entries with cite-doc set (resolved via Typesense
                               ;; lookup). When a chunk lookup fails (e.g. orphan-deleted
                               ;; between v3 baseline and now), it's silently absent.
                               entries (mapv (fn [e]
                                               (let [docs (->> (:cites e)
                                                               (keep chunk->doc)
                                                               set)]
                                                 (assoc e :cite-docs docs)))
                                             entries)
                               ;; Always retrieve a broad pool (≥30) so the scoring threshold
                               ;; isn't conflated with the server's retrieve-top-k. Scoring
                               ;; then takes the first `top-k-int` of the returned list.
                               retrieve-pool-size (max 30 top-k-int)
                               ;; When --expand-queries N is set, call /api/debug/query-planner
                               ;; first to get N LLM-generated expansion phrases per question.
                               ;; Returns a map {:queries "csv" :user-intent "..."} so that
                               ;; the slice-21 first-pass union mode can retrieve twice
                               ;; (once with the user-intent only, once with full expansions).
                               ;; When N is nil, queries=raw question and user-intent=question.
                               ;; `mode` is the expansion-mode keyword. Corpus-aware modes
                               ;; always invoke the planner (passing dataset-config-key +
                               ;; expansion-mode so the PRF harvest can resolve the phrases
                               ;; collection); blind mode only expands when --expand-queries
                               ;; N is set. The planner returns the (grounded) :queries vec.
                               expand-query (fn [question mode]
                                              (let [corpus-aware? (contains?
                                                                   #{:corpus-aware-1hop :corpus-aware-2hop}
                                                                   mode)
                                                    do-expand? (or corpus-aware?
                                                                   (and expand-queries-n (pos? expand-queries-n)))]
                                                (if do-expand?
                                                  (let [resp (call-debug-endpoint-edn
                                                              "/api/debug/query-planner"
                                                              (cond-> {:tenant tenant
                                                                       :query question
                                                                       :max-phrases (str (or expand-queries-n 6))}
                                                                corpus-aware? (assoc :dataset-config-key env
                                                                                     :expansion-mode (name mode))
                                                                (and corpus-aware? expansion-variant-flag)
                                                                (assoc :expansion-variant expansion-variant-flag)))
                                                        phrases (vec (:queries resp))
                                                        user-intent (or (:user-intent resp) question)]
                                                    (if (seq phrases)
                                                      {:queries (clojure.string/join "," phrases)
                                                       :user-intent user-intent}
                                                      {:queries question :user-intent question}))
                                                  {:queries question :user-intent question})))
                               ;; Slice 21: --user-intent-first-pass true triggers a second
                               ;; retrieval pass with ONLY the user-intent string, then
                               ;; unions with the full multi-query pass. The intent is to
                               ;; recover Q1-style cases where expansion broadens the
                               ;; ColBERT candidate pool enough to evict the v3-cited chunks
                               ;; in favour of same-doc siblings.
                               ;;
                               ;; Slice 22: three union modes are now selectable. See
                               ;; plans/in-progress/target-optimal-baseline-v3/22-*.
                               ;; - :interleave (slice-21 default) — alternating zip
                               ;; - :cap        — intent gets first N slots, expansion fills rest
                               ;; - :rrf        — reciprocal-rank-fusion score-sum across passes
                               ;; Slice 22 measurement: cap N=3 dominates interleave and RRF.
                               ;; Strict gains over interleave at every k: +4.3pp top-10
                               ;; chunks, +2.9pp top-30 chunks, +8.4pp top-10 docs (recovers
                               ;; the slice-21 top-10 doc regression), tied on top-30 docs.
                               user-intent-first-pass? (= "true" (str (:user-intent-first-pass flags)))
                               ;; Slice 23: --server-side-union true sends the union to the
                               ;; production retrieval skill in ONE call (intent + queries +
                               ;; mode/cap as parameters). Validates that the server-side
                               ;; union reproduces slice-22 numbers within variance.
                               server-side-union? (= "true" (str (:server-side-union flags)))
                               union-mode (keyword (or (:union-mode flags) "cap"))
                               intent-cap-n (Integer/parseInt (str (or (:intent-cap flags) "3")))
                               union-rrf-k (Integer/parseInt (str (or (:union-rrf-k flags) "60")))
                               ;; Pull retrieved chunks out of one ts-retrieve EDN response
                               ;; into the [{:chunk-id ... :doc-num ...}] vec we score with.
                               unpack-chunks (fn [result]
                                               (->> (or (:chunks result) [])
                                                    (mapv (fn [c]
                                                            {:chunk-id (or (:chunk-id c) (:chunk_id c))
                                                             :doc-num (or (:doc-num c) (:doc_num c))}))))
                               ;; :interleave — alternate one entry from a, then b, ...,
                               ;; dedup by chunk-id, preserving first occurrence.
                               rank-interleave (fn [a b]
                                                 (loop [out [] seen #{} ai 0 bi 0]
                                                   (cond
                                                     (and (>= ai (count a)) (>= bi (count b))) out
                                                     :else
                                                     (let [from-a? (and (< ai (count a))
                                                                        (or (>= bi (count b))
                                                                            (zero? (mod (+ ai bi) 2))))]
                                                       (if from-a?
                                                         (let [x (nth a ai) id (:chunk-id x)]
                                                           (if (or (nil? id) (contains? seen id))
                                                             (recur out seen (inc ai) bi)
                                                             (recur (conj out x) (conj seen id) (inc ai) bi)))
                                                         (let [x (nth b bi) id (:chunk-id x)]
                                                           (if (or (nil? id) (contains? seen id))
                                                             (recur out seen ai (inc bi))
                                                             (recur (conj out x) (conj seen id) ai (inc bi)))))))))
                               ;; :cap — intent's top-N chunks lock into the first N slots
                               ;; of the merged list (dedup ignored — we trust intent for
                               ;; that prefix). Expansion's full list then fills the
                               ;; remainder, skipping any chunk already in the intent prefix.
                               ;; This preserves Q1's intent-rescue without giving up
                               ;; expansion's top-K from the broader pool.
                               cap-merge (fn [a b n]
                                           (let [a-prefix (vec (take n a))
                                                 a-ids (set (map :chunk-id a-prefix))
                                                 b-rest (vec (remove (fn [c] (contains? a-ids (:chunk-id c))) b))]
                                             (vec (concat a-prefix b-rest))))
                               ;; :rrf — Reciprocal-Rank Fusion. score(c) = sum over passes
                               ;; of 1/(k+rank). k=60 is the standard from the literature.
                               ;; Chunks missing from a pass contribute 0. Sort descending
                               ;; by total score. This is the principled choice when both
                               ;; passes contribute independent rank signals.
                               rrf-merge (fn [a b k]
                                           (let [score-list (fn [lst]
                                                              (->> lst
                                                                   (map-indexed (fn [i c]
                                                                                  [(:chunk-id c)
                                                                                   (/ 1.0 (+ k (inc i)))]))
                                                                   (into {})))
                                                 a-scores (score-list a)
                                                 b-scores (score-list b)
                                                 id->chunk (into {} (map (juxt :chunk-id identity)
                                                                         (concat b a)))
                                                 all-ids (distinct (concat (map :chunk-id a)
                                                                           (map :chunk-id b)))]
                                             (->> all-ids
                                                  (map (fn [id]
                                                         {:chunk (get id->chunk id)
                                                          :score (+ (get a-scores id 0.0)
                                                                    (get b-scores id 0.0))}))
                                                  (sort-by (fn [x] (- (:score x))))
                                                  (map :chunk)
                                                  vec)))
                               union-merge (fn [a b]
                                             (case union-mode
                                               :interleave (rank-interleave a b)
                                               :cap (cap-merge a b intent-cap-n)
                                               :rrf (rrf-merge a b union-rrf-k)
                                               (cap-merge a b intent-cap-n)))
                               score-one (fn [{:keys [qnum question cites cite-docs]} mode]
                                           (let [{:keys [queries user-intent]} (expand-query question mode)
                                                 base-params (cond-> {:tenant tenant
                                                                      :dataset-config-key env
                                                                      :limit (str retrieve-pool-size)
                                                                      :retrieve-top-k (str retrieve-pool-size)
                                                                      :auto-filter auto-filter-flag
                                                                      :title-fields title-fields
                                                                      :doc-title-chunk-fanout doc-title-chunk-fanout}
                                                               chunk-content-fields (assoc :chunk-content-fields chunk-content-fields)
                                                               chunk-metadata-fields (assoc :chunk-metadata-fields chunk-metadata-fields)
                                                               retrieval-mode (assoc :retrieval-mode retrieval-mode)
                                                               auto-filter-rules (assoc :auto-filter-rules auto-filter-rules)
                                                               merge-mode (assoc :merge-mode merge-mode)
                                                               rrf-k (assoc :rrf-k rrf-k)
                                                               rerank-with-colbert (assoc :rerank-with-colbert rerank-with-colbert)
                                                               rerank-candidate-k (assoc :rerank-candidate-k rerank-candidate-k)
                                                               per-strategy-rerank (assoc :per-strategy-rerank per-strategy-rerank)
                                                               rerank-final-cap (assoc :rerank-final-cap rerank-final-cap)
                                                               strategy-weights (assoc :strategy-weights strategy-weights)
                                                               strategy-contribution-caps (assoc :strategy-contribution-caps strategy-contribution-caps)
                                                               ;; Enrichment lever: include enrichment collections
                                                               ;; (hypothetical-questions / verified-phrases /
                                                               ;; fact-assertions) as sibling search strategies, so
                                                               ;; the combo (corpus-aware expansion + enrichment) can
                                                               ;; be scored.
                                                               enrichment-types-flag (assoc :enrichment-types enrichment-types-flag))
                                                 ;; Slice 23: server-side-union path sends one request
                                                 ;; with :user-intent + :user-intent-union-enabled true
                                                 ;; and lets the production skill do the merge.
                                                 server-side-result (when (and server-side-union?
                                                                               user-intent-first-pass?
                                                                               (not= user-intent queries))
                                                                      (call-debug-endpoint-edn
                                                                        "/api/debug/typesense-retrieve"
                                                                        (cond-> (assoc base-params
                                                                                       :queries queries
                                                                                       :user-intent user-intent
                                                                                       :user-intent-union-enabled "true"
                                                                                       :user-intent-union-mode (name union-mode)
                                                                                       :user-intent-union-cap (str intent-cap-n))
                                                                          (= :rrf union-mode)
                                                                          (assoc :user-intent-union-rrf-k (str union-rrf-k)))))
                                                 expanded-result (or server-side-result
                                                                     (call-debug-endpoint-edn
                                                                      "/api/debug/typesense-retrieve"
                                                                      (assoc base-params :queries queries)))
                                                 expanded-chunks (unpack-chunks expanded-result)
                                                 retrieved (cond
                                                             ;; Server already merged; just unpack.
                                                             server-side-result expanded-chunks
                                                             ;; Client-side two-call union (slice 21/22 harness flow).
                                                             (and user-intent-first-pass?
                                                                  (not= user-intent queries))
                                                             (let [intent-result (call-debug-endpoint-edn
                                                                                  "/api/debug/typesense-retrieve"
                                                                                  (assoc base-params :queries user-intent))
                                                                   intent-chunks (unpack-chunks intent-result)]
                                                               (union-merge intent-chunks expanded-chunks))
                                                             :else expanded-chunks)
                                                 result expanded-result
                                                 ;; Score at both top-10 and top-30 by default.
                                                 ;; `--top-k N` overrides to a single K.
                                                 top-k-explicit? (some? (:top-k flags))
                                                 score-at (fn [k]
                                                            (let [top (vec (take k retrieved))
                                                                  top-chunk-set (set (map :chunk-id top))
                                                                  top-doc-set (set (map :doc-num top))
                                                                  chunk-hits (clojure.set/intersection cites top-chunk-set)
                                                                  chunk-misses (clojure.set/difference cites top-chunk-set)
                                                                  doc-hits (clojure.set/intersection cite-docs top-doc-set)
                                                                  doc-misses (clojure.set/difference cite-docs top-doc-set)
                                                                  positions (->> top
                                                                                 (map-indexed (fn [i c] [(:chunk-id c) (inc i)]))
                                                                                 (filter (fn [p] (contains? chunk-hits (first p))))
                                                                                 (into {}))]
                                                              {:k k
                                                               :hits chunk-hits
                                                               :misses chunk-misses
                                                               :hit-count (count chunk-hits)
                                                               :hit-positions positions
                                                               :doc-hits doc-hits
                                                               :doc-misses doc-misses
                                                               :doc-hit-count (count doc-hits)}))]
                                             {:qnum qnum
                                              :question question
                                              :total (count cites)
                                              :total-docs (count cite-docs)
                                              :scores (if top-k-explicit?
                                                        [(score-at top-k-int)]
                                                        [(score-at 10) (score-at 30)])
                                              :attribution (:search-attribution result)}))
                               ;; Pretty-print one block per scoring threshold for a
                               ;; given mode's results. Reports BOTH chunk-level (strict,
                               ;; original v3) AND doc-level (slice-21: any chunk from a
                               ;; cited doc counts).
                               print-at-k (fn [results total-cites total-cite-docs k]
                                            (let [pull (fn [r] (->> (:scores r) (filter (fn [s] (= k (:k s)))) first))
                                                  total-hits (reduce + (map (fn [r] (:hit-count (pull r))) results))
                                                  total-doc-hits (reduce + (map (fn [r] (:doc-hit-count (pull r))) results))
                                                  rate (if (zero? total-cites) 0.0 (double (/ total-hits total-cites)))
                                                  doc-rate (if (zero? total-cite-docs) 0.0 (double (/ total-doc-hits total-cite-docs)))]
                                              (println (str "=== v3 hit-rate (top-" k ") ==="))
                                              (doseq [r results]
                                                (let [s (pull r)
                                                      hits-str (->> (:hit-positions s)
                                                                    (sort-by val)
                                                                    (map (fn [[id rk]] (str id "(#" rk ")")))
                                                                    (clojure.string/join ", "))
                                                      misses-str (clojure.string/join ", " (sort (:misses s)))
                                                      doc-misses-str (clojure.string/join ", " (sort (:doc-misses s)))]
                                                  (println (format "Q%s: chunks=%d/%d  docs=%d/%d  hits=[%s]  miss-chunks=[%s]  miss-docs=[%s]"
                                                                   (:qnum r) (:hit-count s) (:total r)
                                                                   (:doc-hit-count s) (:total-docs r)
                                                                   hits-str misses-str doc-misses-str))))
                                              (println)
                                              (println (format "TOTAL chunks (top-%d): %d/%d = %.1f%%"
                                                               k total-hits total-cites (* 100 rate)))
                                              (println (format "TOTAL docs   (top-%d): %d/%d = %.1f%%"
                                                               k total-doc-hits total-cite-docs (* 100 doc-rate)))))
                               ;; Run scoring for one expansion-mode over all questions.
                               run-mode (fn [mode]
                                          (let [results (mapv (fn [e] (score-one e mode)) entries)
                                                total-cites (reduce + (map :total results))
                                                total-cite-docs (reduce + (map :total-docs results))
                                                ks (->> (-> results first :scores) (map :k))]
                                            (doseq [k ks]
                                              (print-at-k results total-cites total-cite-docs k)
                                              (println))))]
                           (if expansion-compare?
                             (doseq [mode [:blind :corpus-aware-1hop :corpus-aware-2hop]]
                               (println (str "\n########## EXPANSION-MODE: " (name mode) " ##########"))
                               (run-mode mode))
                             (run-mode expansion-mode-flag)))}

         enrich-apply {:doc "Apply enrichments to chunks from an EDN spec (usage: bb enrich-apply <spec.edn>). Spec: {:tenant \"digdir\" :dataset-config-key \"public-docs\" :enrichment-type :hypothetical-questions|:verified-phrases|:fact-assertions :prompt-hash \"tag\" :proposals [{:chunk-id \"..\" :doc-num \"..\" :items [..]}]}. Shells out to clojure -M:dev (enrichment skills are dev-only)."
                       :task (let [spec (first *command-line-args*)]
                               (if spec
                                 (let [abs (resolve-from-repo-root spec)
                                       {:keys [exit]} (shell {:dir "server" :continue true}
                                                             "clojure" "-M:dev" "-m"
                                                             "digdir.skills.enrichment.manual" "apply" abs)]
                                   (System/exit (or exit 0)))
                                 (println "Usage: bb enrich-apply <spec.edn>")))}

         enrich-revert {:doc "Revert enrichments for chunk-ids from an EDN spec (usage: bb enrich-revert <spec.edn>). Spec: {:tenant :dataset-config-key :enrichment-type :chunk-ids [..] :prompt-hash \"tag\" (optional)}."
                        :task (let [spec (first *command-line-args*)]
                                (if spec
                                  (let [abs (resolve-from-repo-root spec)
                                        {:keys [exit]} (shell {:dir "server" :continue true}
                                                              "clojure" "-M:dev" "-m"
                                                              "digdir.skills.enrichment.manual" "revert" abs)]
                                    (System/exit (or exit 0)))
                                  (println "Usage: bb enrich-revert <spec.edn>")))}

         chunk-find {:doc "Deterministic chunk diagnostics (usage: bb chunk-find <tenant> <config-root> <config-key> \"<needle>\" [--limit 50] [--exact true|false])"
                     :task (let [args *command-line-args*
                                 tenant (nth args 0 nil)
                                 config-root (nth args 1 nil)
                                 config-key (nth args 2 nil)
                                 needle (nth args 3 nil)
                                 cli-opts (vec (drop 4 args))]
                             (clojure {:dir "server"}
                                      "-M:diagnostics"
                                      "-e"
                                      (str "(require 'digdir.tools.diagnostics)"
                                           "(digdir.tools.diagnostics/chunk-find "
                                           (pr-str {:tenant tenant
                                                    :config-root config-root
                                                    :config-key config-key
                                                    :needle needle
                                                    :cli-opts cli-opts})
                                           ")"
                                           "(System/exit 0)")))}

         retrieve-debug {:doc "Deterministic retrieval diagnostics (usage: bb retrieve-debug <tenant> <config-root> <config-key> \"<user-query>\" [--queries '[\"q1\" \"q2\"]'] [--no-auto-filter] [--limit 120])"
                         :task (let [args *command-line-args*
                                     tenant (nth args 0 nil)
                                     config-root (nth args 1 nil)
                                     config-key (nth args 2 nil)
                                     user-query (nth args 3 nil)
                                     cli-opts (vec (drop 4 args))]
                                 (clojure {:dir "server"}
