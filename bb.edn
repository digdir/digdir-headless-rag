         rerank-language-report {:doc "Run rerank-language-benchmark and print compact NO vs EN comparison (usage: bb rerank-language-report <tenant> <config-root> <config-key> --fixture <file.edn> [rerank-language-benchmark flags...])"
                                 :task (let [args *command-line-args*
