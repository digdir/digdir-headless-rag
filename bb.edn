         ;; Parameterized deploy tasks
         deploy-server {:doc "Deploy server (usage: bb deploy-server <destination>, e.g., bb deploy-server prod)"
                       :task (let [dest (first *command-line-args*)]
                               (if dest
                                 (let [kamal-dest (kamal-destination dest)]
                                   (if (= kamal-dest "prod")
                                     (shell "kamal" "deploy" "--config-file=deploy.yml")
                                     (shell "kamal" "deploy" "--config-file=deploy.yml" (str "--destination=" kamal-dest))))
                                 (show-destination-error "deploy-server")))}

         ;; Parameterized boot tasks
         boot-server {:doc "Boot server (usage: bb boot-server <destination>, e.g., bb boot-server prod)"
                     :task (let [dest (first *command-line-args*)]
