;; Does the read-snippet self-selection lever (+0.083 on the local 35B) still pay off
;; when the synthesizer is frontier-tier, or does Kimi self-select without the
;; scaffolding (→ we could simplify the deployed prompt)? Two arms, identical except:
;;   control    : :qwen-adapted          + search-snippets FALSE
;;   snippet-AB : :qwen-adapted-snippet   + search-snippets TRUE
;; Both: enriched-HQ retrieval + no-tool-call guard (search-snippets set EXPLICITLY on
;; both so the ablation is unambiguous regardless of graph default).
;; 2 × 42 × N=3 = 252 runs, conc-48, judge? false.
{:configs
 [{:id "control"
   :skill-graph-id :builtin/agent-rag-graph-bundled
   :agent-prompt-variant :qwen-adapted
   :skill-params
   #:builtin{:retrieval
             {:enrichment-types [:hypothetical-questions]
              :enrichment-search-targets
              {:hypothetical-questions
               "website_enrichment_hypothetical_questions_qwen_n5"}}
             :agent {:search-snippets false
                     :no-tool-call-retry true}}}
