;; Round 5 — Round-4 stacked retrieval × skill-graph variant
;;
;; Round 4 found that the stacked combo (phrase-only weights, capped
;; strategy contribution, retrieve-top-k=100) gives 27.8% recall@10
;; — the highest of any sweep so far. That's all under the
;; :builtin/agent-rag-graph-bundled inner. Baseline-v0 (with default
;; retrieval) showed faithful was the hit-rate winner. Question for
;; Round 5: does the faithful inner compound the merge-tuning gains,
;; or does its 10-step inner consume the workspace before rerank can
;; pick the right chunks?
;;
;; Hold all Round-4 winning retrieval params constant:
;;   - strategy-weights {:content 0 :phrase 1 :metadata 0}
;;   - strategy-contribution-caps {:phrase 5 :content 0 :metadata 0}
;;   - retrieve-top-k 100
;;   - rerank :top-k 20  (Round-2 winner)
;;
;; Cells:
;;   r5-bundled  — control; reproduces r4-stacked
;;   r5-faithful — switches inner to :builtin/agent-rag-graph-faithful
;;
;; Filter: chunks+answer rows only (n=18).
;; Repeats: 3.
;;
;; Expected wall-clock: 2 × 18 × 3 = 108 runs × ~30s = ~55 min.
;;
;; Drive from REPL:
;;   (digdir.sweep.runner/run-from-files
;;     {:matrix-path "test/fixtures/sweep/matrices/round-5-stacked-x-graph.edn"})

{:configs
 [{:id "r5-bundled"
   :skill-graph-id :builtin/agent-rag-graph-bundled
   :skill-params
   {:builtin/retrieval {:strategy-weights {:content 0.0
                                           :phrase 1.0
                                           :metadata 0.0}
                        :strategy-contribution-caps {:phrase 5
                                                     :content 0
                                                     :metadata 0}
                        :retrieve-top-k 100}
    :builtin/rerank    {:top-k 20}}}

  {:id "r5-faithful"
   :skill-graph-id :builtin/agent-rag-graph-faithful
   :skill-params
   {:builtin/retrieval {:strategy-weights {:content 0.0
                                           :phrase 1.0
                                           :metadata 0.0}
                        :strategy-contribution-caps {:phrase 5
                                                     :content 0
                                                     :metadata 0}
                        :retrieve-top-k 100}
    :builtin/rerank    {:top-k 20}}}]

 :repeats 3
 :max-clarification-rounds 2

 :execution-scope
 {:tenant "digdir"
  :dataset-config-key "default"
  :agent-id "builtin/agent-rag-agent"}

 :question-filter {:grounding-modes #{:chunks+answer}}}
