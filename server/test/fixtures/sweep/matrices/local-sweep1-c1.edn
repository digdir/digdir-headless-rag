   :skill-graph-id :builtin/agent-rag-graph-bundled
   :agent-prompt-variant :qwen-adapted
   :skill-params #:builtin{:rerank {:context-top-k 6 :max-context-length 5000}}}]
 :repeats 1
 :judge? false
 :order :interleaved
 :concurrency 1
