;; MODEL HEAD-TO-HEAD — full-42, the DEPLOYED config held constant, model swapped
;; externally (per-arm `bb config-set services.azure-openai.model-name <ollama-tag>`
;; + per-arm OPENAI_* sampling env). See orchestration script
;; `scripts/model-h2h-overnight.sh` and plan
;; `plans/proposed/model-headtohead-plan.md`.
;;
;; The ONE config below == the deployed snippet-AB arm (enriched-HQ base +
;; :qwen-adapted-snippet prompt + :search-snippets true), i.e. the production
;; config whose synthesis-extraction ceiling we are probing. We run this SAME
;; matrix once per model arm:
;;   - control : Qwen3.6-35B-A3B  (MoE, ~3B active)  [incumbent]
;;   - dense   : Qwen3.6-27B       (dense, all active) [primary diagnostic]
;;   - gemma   : gemma-4-31B-it-qat (dense, QAT-Q4)   [cross-family dense]
;; All three served on gx10 (GB10) via ollama, one model loaded at a time
;; (unloaded between arms). judge? false here — gpt-5.5 judge runs as a SEPARATE
;; azure-on pass (`bb sweep-judge <dir>`) so the agent stays azure-off.
;;
;; NOTE: the :qwen-adapted-snippet prompt is held constant across ALL arms
;; (including gemma) — this is the controlled experiment (swap ONLY the model).
;; A prompt that a model can't tool-call cleanly under is caught by the smoke gate.
{:configs
 [{:id "deployed"
   :skill-graph-id :builtin/agent-rag-graph-bundled
   :agent-prompt-variant :qwen-adapted-snippet
   :skill-params
   #:builtin{:retrieval
             {:enrichment-types [:hypothetical-questions]
              :enrichment-search-targets
              {:hypothetical-questions
               "website_enrichment_hypothetical_questions_qwen_n5"}}
             :agent {:search-snippets true}}}]
 :repeats 3
 :judge? false
 :order :interleaved
 :concurrency 32
 :max-clarification-rounds 1
 :run-timeout-ms 3000000
 :execution-scope {:tenant "digdir" :dataset-config-key "default" :agent-id "builtin/agent-rag-agent"}
 :question-filter
