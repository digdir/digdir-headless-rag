# E2E harness configuration.
#
# Copy to `.env` (which is gitignored). docker-compose reads .env
# automatically when launched via `docker-compose -f docker-compose.e2e.yml`.
#
# The same value is consumed by:
#   - digdir-rag (boot-time auto-seed in digdir.e2e.seed/maybe-seed!).
#     Writes this exact plaintext into the config DB on first boot so
#     wrap-api-key-auth recognizes it; idempotent on subsequent boots.
#   - mcpo (env-interpolated into config.json's `X-API-Key` header).
#
# Rotate the value below for your local stack — the one shipped here
# is fine for local development, but treat anything in .env as a real
# secret if you change it.

E2E_API_KEY=rag_920d67d69da05b500568aa6d041bc003ea97b8784a03f960df0085612793f600

# Bootstrap config required by digdir.config.core/load-bootstrap-config —
# without these the server refuses to start ("JWT_SECRET must be configured")
# and the auto-seed has no DB connection to write into.
#
# Test values only; the stack runs on localhost-only ports. Replace with
# real secrets if you're standing up something that talks to a real frontend.
CONFIG_MASTER_KEY=e2e-stack-test-master-key-not-a-real-secret
JWT_SECRET=e2e-stack-test-jwt-signing-secret-not-a-real-secret

# E2E debug scaffolds (used by Layer-C Playwright tests for
# agent-scoped skill-params). The boot wires both into the digdir-rag
# service in docker-compose.e2e.yml; override here if you want a
# rotated value. Setting DIGDIR_DEBUG_LAST_INVOCATION=false disables
# /api/debug/last-invocation and /api/debug/agent-resolution.
DIGDIR_DEBUG_LAST_INVOCATION=true
RAG_DEBUG_API_KEY=e2e-debug-key

# Optional: tenant + dataset-config-key the seed targets when bootstrapping
# the conversation row that MCP tool calls create. These do NOT need to
# match real datasets — invoke-rag will surface a clean error frame if
# they don't, which is what the stack-up Playwright spec asserts on.
TENANT=e2e-tenant
DATASET_CONFIG_KEY=e2e

# Azure OpenAI — required for the 10-tool-invocation happy-path spec
# to actually call an LLM (rather than skipping). When set, the
# boot-time auto-seed in digdir.e2e.seed/seed-azure-config-from-env!
# writes these into the platform config DB at the global node so
# `cfg/get {:tenant t} :services :azure-openai ...` resolves them.
# The values below mirror what's in the running dev instance — leave
# AZURE_OPENAI_API_KEY unset to skip Azure seeding entirely.
#
# IMPORTANT: API_ENDPOINT is the bare resource host. Do NOT include
# `/openai/responses`, `/openai/deployments/...`, or any `?api-version=...`
# query string — the Azure client appends the correct path itself, and
# a pre-composed URL produces a 404. Updated 2026-05-21 to the
# altinn-assistant Azure resource (more deployments than the previous
# ai-extbbrodai388535949051 host).
AZURE_OPENAI_API_ENDPOINT=https://altinn-assistant-gpt4-1106-preview.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_MODEL_NAME=gpt-5.4-mini
AZURE_OPENAI_USE_AZURE=true
AZURE_OPENAI_API_KEY=
