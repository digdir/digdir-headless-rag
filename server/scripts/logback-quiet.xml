<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback config for `mcp_conformance_check.clj`. Mutes the load-time
  Jetty / mchange / digdir noise so the seven-check output isn't
  drowned in DEBUG spam.

  Pass via -J:
    clojure -J-Dlogback.configurationFile=scripts/logback-quiet.xml -M -e ...
-->
<configuration>
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger{0} -- %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>

  <!-- Everything below the root we explicitly silence. -->
  <logger name="org.eclipse.jetty"      level="OFF"/>
  <logger name="com.mchange"            level="OFF"/>
  <logger name="hato"                   level="OFF"/>
  <logger name="digdir"                 level="WARN"/>
  <logger name="digdir.mcp"             level="OFF"/>
  <logger name="digdir.api"             level="OFF"/>
</configuration>
