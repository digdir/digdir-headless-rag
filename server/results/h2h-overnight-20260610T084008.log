nswer-substring-hit? true, :retrieved-chunk-ids "6d1c5124b842", :enrichment-hits 61, :n-expected 1, :status "complete", :recall-at-20 1.0, :refinement-corpus-grounded? nil, :n-cited 1, :prompt-tokens 6685, :pool-head "", :repeat 0, :error nil, :cited-chunk-ids "6d1c5124b842", :expected-chunk-ids "6d1c5124b842", :elapsed-ms 475400, :issued-queries "delegere tilgangspakke API endpoint | Access Management delegate access package | delegate user access resource Altinn API", :timestamp "2026-06-10T11:45:40.235875Z", :total-tokens 6933, :run-id "432abe96-11f5-41c0-b75a-50109faa2d32", :golden-display-rank 1, :steps-executed 3, :dataset "public-docs", :length-finish? false, :recall-at-5 1.0} {:response "Du kan begrense tilgangen ved å bruke et **handlingsfilter** (`actionFilters`) når du tilordner hver tilgangsliste til ressursen [1]. Dette konfigureres via en PUT-forespørsel til `/access-lists/{owner}/{identifier}/resource-connections/{resourceIdentifier}` med en JSON-payload som definerer de tillatte handlingene for den aktuelle listen [1].\n\nFor å oppnå din spesifikke oppsett:\n* På den tilgangslisten som kun skal gi lesetilgang, angi `actionFilters` som `[\"read\"]`.\n* På den andre tilgangslisten, angi `actionFilters` som `[\"read\", \"write\"]` for både lese- og skrivetilgang [1].\n\nMerk at hvis du oppgir en null eller tom liste, blir alle handlinger tillatt for listen i spørsmål [1]. De angitte filterverdiene må dessuten samsvare med de definerte handlingene i XACML-policyen til ressursen [1…", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? true, :question-id "ue-authz-02-tilgangsliste-handlingsfilter", :empty? false, :llm-calls 2, :citation-recall 1.0, :completion-tokens 251, :insufficiency-fired? false, :recall-at-10 1.0, :config-id "deployed", :clarification-rounds 0, :question-tags "altinn-authorization,hard", :cached-tokens 0, :golden-features "d71a2362d8513 R23.0 P4.8 h4.0 or1.9 L612 4/? ty:content+hypothetical-questions+meta