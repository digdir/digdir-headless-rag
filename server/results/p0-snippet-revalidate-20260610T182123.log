us "complete", :recall-at-20 1.0, :refinement-corpus-grounded? nil, :n-cited 1, :prompt-tokens 8277, :pool-head "", :repeat 0, :error nil, :cited-chunk-ids "68a9ae627a18", :expected-chunk-ids "68a9ae627a18", :elapsed-ms 260993, :issued-queries "programmatisk opprettelse dialoger API synkronisering | API tidslinje | tidslinjer API app", :timestamp "2026-06-10T21:23:09.264584Z", :total-tokens 8778, :run-id "1d041cca-176e-4fd7-ad8c-c837cc8fe622", :golden-display-rank 1, :steps-executed 3, :dataset "public-docs", :length-finish? false, :recall-at-5 1.0} {:response "Når du trenger mer kontroll enn den automatiske synkroniseringen tilbyr, kan du løse dette ved å bruke **[Dialogporten WebAPI SDK](https://github.com/Altinn/dialogporten/tree/main/src/Digdir.Library.Dialogporten.WebApiClient)** [1]. Dette gir applikasjonen din programmatisk tilgang til Dialog-porten, slik at du selv kan opprette og oppdatere dialoger via API-et [1]. Gjennom dette får du mulighet til finkornet håndtering av aktiviteter, forsendelser og synkronisering med Altinn Innboks [1].\n\nNår du bruker SDK/API-et finner du detaljert dokumentasjon som dekker selve arbeidsflyten:\n* Veiledninger viser hvordan man oppretter dialoger ved hjelp av tjenesteeier-API-et [3].\n* Retningslinjer for oppdatering beskriver hvilke felt som kan endres underveis, samt spesifikke unntak (f.eks. at part og tjenesteressurs ikke kan endres etter opprettelse, samt at aktiviteter og forsendelser er ikkje-muterbare) [2].\n\nDette gir deg den eksplisitte kontrollen du trenger når automatisering alene ikke dekker behovet ditt.", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? true, :question-id "ue-dialog-07-webapi-sdk", :empty? false, :llm-calls 6, :citation-recall 1.0, :completion-tokens 842, :insufficiency-fired? false, :recall-at-10 1.0, :config-id "control", :clarification-rounds 0, :question-tags "altinn-dialogporten,hard", :cached-tokens 0, :golden-features "d6ed96a9e4492 R19.7 P2.6 h2.0 or