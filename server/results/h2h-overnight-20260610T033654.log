n* **`subjectFilter`**: Skal settes til `\"urn:altinn:organization:identifier-no:{{recipient_orgnumber…", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? true, :question-id "ue-corr-01-events-webhook-subscription", :empty? false, :llm-calls 2, :citation-recall 0.0, :completion-tokens 579, :insufficiency-fired? false, :recall-at-10 0.0, :config-id "deployed", :clarification-rounds 0, :question-tags "altinn-correspondence,hard", :cached-tokens 0, :golden-features "d7a010952d7b4 R16.4 P2.4 h2.0 or0.4 L6240 0/? ty:content+hypothetical-questions b[0.0,0.0,0.0,0.4,0.0,0.0] +q | Events", :source "new", :search-passes 1, :n-retrieved 2, :reasoning-tokens 0, :golden-in-search-pool? true, :golden-pool-rank 16, :golden-read? false, :grounding-mode :chunks+answer, :answer-substring-hit? true, :retrieved-chunk-ids "50da0cfe12bd;54a01225a6af", :enrichment-hits 64, :n-expected 1, :status "complete", :recall-at-20 0.0, :refinement-corpus-grounded? nil, :n-cited 2, :prompt-tokens 6245, :pool-head "ddabe88fb244e R23.9 P2.5 h2.0 or1.1 L5909 0/? ty:content+hypothetical-questions b[0.0,0.0,0.0,0.4,0.0,0.0] +q | Events ;; d99b415acaa9e R23.0 P3.6 h3.0 or1.2 L1317 0/? ty:content+hypothetical-questions+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] +q | Setup subscription ;; d401bc7f6daf0 R21.1 P1.5 h1.0 or1.0 L4541 0/? ty:content b[0.0,0.0,0.0,0.4,0.0,0.0] | Maskinporten ;; d99b415acaa9e R20.3 P2.5 h2.0 or1.4 L6345 1/? ty:content+hypothetical-questions b[0.0,0.0,0.0,0.4,0.0,0.0] +q | Setup subscription ;; d1e4efbbf66b8 R20.2 P1.4 h1.0 or0.7 L720 0/? ty:content b[0.0,0.0,0.0,0.4,0.0,0.0] | Message ;; d7208db2576a9 R19.8 P2.6 h2.0 or1.4 L456 0/? ty:content+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] | Developer guides ;; dc51a8a91da05 R19.7 P2.5 h2.0 or0.8 L945 0/? ty:content+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] | Custom templates ;; d20cbf3c2523d R19.7 P1.4 h1.0 or0.7 L542 0/? ty:content b[0.0,0.0,0.0,0.4,0.0,0.0] | Pages", :repeat 0, :error nil, :cited-chunk-ids "50da0cfe12bd;54a01