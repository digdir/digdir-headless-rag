ippet-AB", :clarification-rounds 0, :question-tags "altinn-notifications,hard", :cached-tokens 0, :golden-features "d286593dbb706 R23.2 P3.7 h3.0 or2.0 L774 0/? ty:content+hypothetical-questions+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] +q | Custom sender", :response-chars 467, :source "new", :search-passes 1, :n-retrieved 2, :reasoning-tokens 0, :golden-in-search-pool? true, :golden-pool-rank 1, :golden-read? true, :grounding-mode :chunks+answer, :answer-substring-hit? true, :retrieved-chunk-ids "1ae507a826c4;9c58e66b93a3", :enrichment-hits 45, :n-expected 1, :status "complete", :recall-at-20 1.0, :refinement-corpus-grounded? nil, :n-cited 1, :prompt-tokens 6846, :pool-head "", :repeat 0, :error nil, :cited-chunk-ids "1ae507a826c4", :expected-chunk-ids "1ae507a826c4", :elapsed-ms 202285, :issued-queries "Altinn varsling avsender SMS e-post | varsling default sender SMS email | VarslingConfigurajson avsendervurdu", :timestamp "2026-06-11T16:22:38.466294Z", :total-tokens 7226, :run-id "616c36e4-9def-43bf-8adc-8202a21b37a7", :golden-display-rank 1, :steps-executed 3, :dataset "public-docs", :length-finish? false, :recall-at-5 1.0} {:response "Ifølge dokumentasjonen gjelder følgende standard avsendere dersom du ikke har konfigurert egne:\n\n- **SMS:** Avsender er **\"Altinn\"** (eller **\"Altinn-test\"** for testmiljøet).\n- **E-post:** Avsender er **noreply@altinn.no** (**noreply-tt02@altinn.no** for testmiljøet og **noreply@altinn.cloud** for ytelsestestmiljøet).\n\nDet står uttrykt at det ikke er nødvendig å benytte egendefinerte avsendere for å sende varsler gjennom Altinn Varsling, så disse standardverdiene vil fungere som forventet.", :terminal-clarification? false, :finish-reason "stop", :golden-in-display? true, :question-id "ue-notif-07-standard-avsender-sms-epost", :empty? false, :llm-calls 4, :citation-recall 0.0, :completion-tokens 745, :insufficiency-fired? false, :recall-at-10 1.0, :config-id "snippet-AB+read-hi", :clarification-rounds 0, :question-tags "altinn-n