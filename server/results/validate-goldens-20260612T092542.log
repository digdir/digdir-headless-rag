, :length-finish? false, :recall-at-5 0.0} {:response "Based on the provided context, retrieving system user information requires the following endpoint and scope from the Systemuser API documentation:\n\n- **Endpoint:** `GET authentication/api/v1/systemuser/vendor/bysystem/{systemId}` is used to query data by substituting `{systemId}` with the unique identifier of the registered system [1]. \n- **Scope:** The request must be authenticated using a Maskinporten token that includes the `<mark>altinn:authentication/systemregister.write</mark>` scope [1].", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? true, :question-id "wg-api-09-systemuser-vendor-endpoint-en", :empty? false, :llm-calls 2, :citation-recall 1.0, :completion-tokens 297, :insufficiency-fired? false, :recall-at-10 1.0, :config-id "deployed+enrichment", :clarification-rounds 0, :question-tags "lookup,simple,altinn-3-general", :cached-tokens 0, :golden-features "d0afc8c2281ac R25.8 P2.6 h2.0 or1.5 L8499 0/? ty:content+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] | External", :response-chars 499, :source "new", :search-passes 1, :n-retrieved 1, :reasoning-tokens 0, :golden-in-search-pool? true, :golden-pool-rank 1, :golden-read? true, :grounding-mode :chunks+answer, :answer-substring-hit? true, :retrieved-chunk-ids "589dbc519957", :enrichment-hits 36, :n-expected 1, :status "complete", :recall-at-20 1.0, :refinement-corpus-grounded? nil, :n-cited 1, :prompt-tokens 6187, :pool-head "", :repeat 0, :error nil, :cited-chunk-ids "589dbc519957", :expected-chunk-ids "589dbc519957", :elapsed-ms 133817, :issued-queries "Systemuser API get system user information registered system | Systembruker-API endpoint scope liste-systembrukere | systembruksrett endpoint api registert system", :timestamp "2026-06-12T12:04:09.472308Z", :total-tokens 6484, :run-id "3ed58641-2ba7-4f1a-8056-9fc404b9b880", :golden-display-rank 1, :steps-executed 3, :dataset "public-docs", :length-finish? false, :recall-at-5 1.