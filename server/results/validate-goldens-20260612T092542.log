xact response matches constraints and language!)*  *(Done.)*", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? true, :question-id "wg-studio-02-sideinnstillinger", :empty? false, :llm-calls 3, :citation-recall 1.0, :completion-tokens 413, :insufficiency-fired? false, :recall-at-10 1.0, :config-id "deployed+enrichment", :clarification-rounds 0, :question-tags "compound,lookup,altinn-studio,list", :cached-tokens 0, :golden-features "d20cbf3c2523d R20.2 P2.6 h2.0 or0.8 L8265 1/? ty:content+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] | Pages", :response-chars 4310, :source "new", :search-passes 1, :n-retrieved 1, :reasoning-tokens 0, :golden-in-search-pool? true, :golden-pool-rank 1, :golden-read? true, :grounding-mode :chunks+answer, :answer-substring-hit? true, :retrieved-chunk-ids "d2209cafc7cc", :enrichment-hits 54, :n-expected 1, :status "complete", :recall-at-20 1.0, :refinement-corpus-grounded? nil, :n-cited 1, :prompt-tokens 8112, :pool-head "", :repeat 0, :error nil, :cited-chunk-ids "d2209cafc7cc", :expected-chunk-ids "d2209cafc7cc", :elapsed-ms 306127, :issued-queries "pages objekt i settings json | Settings.json pages stillinger | \"settings\" \"pages\" altinn app konfigurering", :timestamp "2026-06-12T07:53:17.215032Z", :total-tokens 8525, :run-id "f0f7e1d8-6a00-4d87-8192-65d00f5393ec", :golden-display-rank 1, :steps-executed 3, :dataset "public-docs", :length-finish? false, :recall-at-5 1.0} {:response "Based on the provided context, to use the Altinn correspondence (melding) service, a Maskinporten client requires access to the following scopes [1]:\n\n- `altinn:serviceowner`\n- `altinn:correspondence.read`\n- `altinn:correspondence.write`", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? false, :question-id "wg-studio-03-correspondence-scopes", :empty? false, :llm-calls 3, :citation-recall 0.0, :completion-tokens 394, :insufficiency-fired? false, :recall-at-10 0.0, :config-id "deployed", :clarificat