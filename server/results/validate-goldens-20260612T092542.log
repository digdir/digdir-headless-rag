 and changes of state [1].\n- **BPMN reader**: The component that parses BPMN process in apps [1].\n\nThese labels represent separate responsibilities (client-facing control vs. backend business/state verification vs. initial parsing), so they should not be conflated into one concept unless explicitly combined by the source, which it does not do here.", :terminal-clarification? false, :finish-reason "tool_calls", :golden-in-display? true, :question-id "wg-apptmpl-02-app-process-components", :empty? false, :llm-calls 3, :citation-recall 0.0, :completion-tokens 514, :insufficiency-fired? false, :recall-at-10 0.0, :config-id "deployed+enrichment", :clarification-rounds 0, :question-tags "compound,lookup,altinn-3-general,list", :cached-tokens 0, :golden-features "d34120f8cce3c R20.0 P3.5 h3.0 or0.3 L1492 0/? ty:content+hypothetical-questions+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] +q | Process", :response-chars 764, :source "new", :search-passes 1, :n-retrieved 1, :reasoning-tokens 0, :golden-in-search-pool? true, :golden-pool-rank 2, :golden-read? false, :grounding-mode :chunks+answer, :answer-substring-hit? true, :retrieved-chunk-ids "8c1477bcab54", :enrichment-hits 41, :n-expected 1, :status "complete", :recall-at-20 0.0, :refinement-corpus-grounded? nil, :n-cited 1, :prompt-tokens 7785, :pool-head "d3010c03cb6f3 R20.1 P2.6 h2.0 or0.5 L1509 0/? ty:content+phrase b[0.0,0.0,0.0,0.4,0.0,0.0] | Process", :repeat 0, :error nil, :cited-chunk-ids "8c1477bcab54", :expected-chunk-ids "036b93352353", :elapsed-ms 325520, :issued-queries "BPMN process components handled by which services modules | what does the BPMN process mean in app backend", :timestamp "2026-06-12T14:52:36.891695Z", :total-tokens 8299, :run-id "3ab4cdbf-3bda-4960-a7f5-504ef2db86f5", :golden-display-rank 2, :steps-executed 3, :dataset "public-docs", :length-finish? false, :recall-at-5 0.0}], :out-dir "results/sweep-2026-06-12T07-26-40-452436Z", :csv-path "results/sweep-2026-06-12T07-26-40-452436Z/runs.csv"}
