{
  "info": {
    "name": "Digdir RAG API",
    "description": "Public API and internal Operator Console examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://admin.kunnskap.digdir.cloud",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "rag_your_api_key_here",
      "type": "string"
    },
    {
      "key": "jwt_cookie",
      "value": "auth-token=YOUR_JWT_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "List Datasets",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/datasets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "datasets"
              ]
            }
          }
        },
        {
          "name": "Get Dataset",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/datasets/public-docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "datasets",
                "public-docs"
              ]
            }
          }
        },
        {
          "name": "MCP - tools/list",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mcp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mcp"
              ]
            }
          }
        },
        {
          "name": "MCP - tools/call",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"builtin.agent-rag-agent__agent-rag-graph-bundled\",\n    \"arguments\": {\n      \"user-query\": \"Hva er Altinn?\",\n      \"tenant\": \"digdir\",\n      \"dataset_config_key\": \"public-docs\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mcp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mcp"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "customer-user-123"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/conversations?page_size=10&page_index=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "conversations"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "10"
                },
                {
                  "key": "page_index",
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Operator Console API Keys",
      "item": [
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{jwt_cookie}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/console-api/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "console-api",
                "api-keys"
              ]
            }
          }
        },
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{jwt_cookie}}"
              },
              {
                "key": "X-User-Email",
                "value": "user@example.com"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Public Docs Integration\",\n  \"dataset-scopes\": [\n    {\n      \"tenant\": \"digdir\",\n      \"dataset-config-key\": \"public-docs\"\n    }\n  ],\n  \"allowed-config-keys\": [\n    {\n      \"root\": \"dataset\",\n      \"tenant\": \"digdir\",\n      \"dataset-config-key\": \"public-docs\"\n    },\n    {\n      \"root\": \"runtime\",\n      \"tenant\": \"digdir\",\n      \"runtime-config-key\": \"default\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/console-api/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "console-api",
                "api-keys"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Operator Console Datasets",
      "item": [
        {
          "name": "List Datasets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{jwt_cookie}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/console-api/datasets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "console-api",
                "datasets"
              ]
            }
          }
        },
        {
          "name": "Create Dataset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{jwt_cookie}}"
              },
              {
                "key": "X-User-Email",
                "value": "user@example.com"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Public Docs\",\n  \"description\": \"Shared docs\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/console-api/datasets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "console-api",
                "datasets"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Operator Console Pipelines",
      "item": [
        {
          "name": "Create Child Pipeline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{jwt_cookie}}"
              },
              {
                "key": "X-User-Email",
                "value": "user@example.com"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant\": \"digdir\",\n  \"dataset-config-key\": \"public-docs\",\n  \"pipeline-name\": \"assistant\",\n  \"properties\": {\n    \"name\": \"Assistant\",\n    \"sourceType\": \"website\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/console-api/datasets/ds_123/pipelines",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "console-api",
                "datasets",
                "ds_123",
                "pipelines"
              ]
            }
          }
        },
        {
          "name": "Execute Child Pipeline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{jwt_cookie}}"
              },
              {
                "key": "X-User-Email",
                "value": "user@example.com"
              }
            ],
            "url": {
              "raw": "{{base_url}}/console-api/datasets/ds_123/pipelines/assistant/execute?tenant=digdir&dataset-config-key=public-docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "console-api",
                "datasets",
                "ds_123",
                "pipelines",
                "assistant",
                "execute"
              ],
              "query": [
                {
                  "key": "tenant",
                  "value": "digdir"
                },
                {
                  "key": "dataset-config-key",
                  "value": "public-docs"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
