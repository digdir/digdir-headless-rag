 ;; These reach processes started through the Clojure CLI — `bb dev`, `bb test`,
 ;; every one-shot `clojure -M`. They do NOT reach production: server.Dockerfile
 ;; runs `java -cp app.jar clojure.main -m prod`, which never consults deps.edn,
 ;; so anything needed at runtime has to be repeated in that CMD (#113).
 ;;
 ;; What production pins there, and why the split falls where it does:
 ;;   -Dfile.encoding / -Dstdout.encoding / -Dstderr.encoding  shipped
 ;;   --enable-native-access=ALL-UNNAMED                       shipped
 ;;   -Djdk.attach.allowAttachSelf     dev only — self-attaching profilers
 ;;   -Dclojure.spec.skip-macros       dev only — macro expansion, moot for an
 ;;                                    already-compiled uberjar
 ;;
 ;; Encoding is not actually pinned by these flags in the image: LANG and LC_ALL
 ;; are unset there, and sun.jnu.encoding follows the locale rather than any -D,
 ;; so the Dockerfile sets LANG=C.UTF-8. The measured table is in that file.
 :jvm-opts ["-Djdk.attach.allowAttachSelf"
            "-Dfile.encoding=UTF-8"
            "-Dconsole.encoding=UTF-8"
            "-Dclojure.spec.skip-macros=true"
            ;; Silence the JDK 21 "restricted method" warnings emitted by
            ;; JNA, com.sun.jna.Native, and JBoss/jboss-threads' use of
            ;; sun.misc.Unsafe. Granting native access at the unnamed-
            ;; module level is the documented opt-in path; without it
            ;; every boot prints 7-8 deprecation lines that drown out
            ;; meaningful startup signal.
            "--enable-native-access=ALL-UNNAMED"]
 :paths   ["src" "resources"]
 :aliases {:dev {:extra-paths ["src-dev"]
                 :extra-deps {thheller/shadow-cljs {:mvn/version "2.26.2"}}}

           ;; Opt-in hook for personal tooling. The dev entrypoints in bb.edn
           ;; invoke -X:personal/dev:dev so a developer can layer their own
           ;; nrepl middleware, Portal, etc. via a :personal/dev alias in
           ;; ~/.clojure/deps.edn. Declaring it empty here keeps Clojure from
           ;; printing "Specified aliases are undeclared" on every boot;
           ;; because the map is empty it contributes no keys, so a user-level
           ;; :personal/dev still applies in full. Keep it empty.
           :personal/dev {}

           :diagnostics {:extra-paths ["src-dev"]
                         :jvm-opts ["-Ddigdir.skip-user-dev=true"]}

           :1.12-storm
           {;; for disabling the official compiler
            :classpath-overrides {org.clojure/clojure nil}
            :extra-deps {com.github.flow-storm/clojure {:mvn/version "1.12.0-9"}
                         com.github.flow-storm/flow-storm-dbg {:mvn/version "4.3.0"}}}

           :prod {:extra-paths ["src-prod"]
                  :extra-deps {com.google.javascript/closure-compiler-unshaded {:mvn/version "v20230802"}}} ; deps conflict
           
           :build ; use `clj -X:build build-client`, NOT -T!
           {:extra-paths ["src-build"]
            :ns-default  build
            :extra-deps  {thheller/shadow-cljs          {:mvn/version "2.26.2"}
                          io.github.clojure/tools.build {:mvn/version "0.10.11"}}}

           :test {:extra-paths ["test" "src-dev"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/tools.namespace {:mvn/version "1.5.0"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :jvm-opts ["-Dhyperfiddle.rcf.enable=true"
                             "-Dhyperfiddle.rcf.generate-tests=true"
                             "-Ddigdir.skip-user-dev=true"
                             ;; Keep the config cache-invalidation poller out of
                             ;; test JVMs. It reassigns the process-global config
                             ;; conn from a daemon thread, which yanks that conn
                             ;; away from tests that set it deliberately.
                             "-Ddigdir.config.poller=false"]}

