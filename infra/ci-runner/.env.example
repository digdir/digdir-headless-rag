# Copy to `.env` (gitignored) ON THE BOX before `docker compose up -d`.
#
# RUNNER_TOKEN is a GitHub Actions REGISTRATION token — short-lived (~1h) and
# consumed only the first time the container is created (see the image's
# entrypoint.sh: it skips config.sh when /actions-runner/.runner exists).
# Fetch a fresh one immediately before creating a NEW container:
#
#   gh api -X POST repos/itonomi/digdir-headless-rag/actions/runners/registration-token --jq .token
#
# Needs repo admin on itonomi/digdir-headless-rag. Do not echo it; pipe it
# straight into .env.
RUNNER_TOKEN=

# Non-secret. Where the bind-mounted runner work dir and m2 cache live.
DIGDIR_CI_ROOT=/mnt/HC_Volume_106331869/digdir-ci
